-- Конструктор графических примитивов Drawing API
local function NewDrawing(type, props)
    local obj = Drawing.new(type)
    for k, v in pairs(props) do obj[k] = v end
    return obj
end

-- Безопасный регистронезависимый поиск костей структуры R6 персонажей
local function GetR6Part(model, name)
    if not model then return nil end
    local cleanName = name:lower():gsub("%s+", "")
    for _, child in ipairs(model:GetChildren()) do
        if child:IsA("BasePart") and child.Name:lower():gsub("%s+", "") == cleanName then
            return child
        end
    end
    return nil
end

-- Метод жесткого обнуления координат (Защита от замерзания ESP при повороте камеры)
local function ResetESP(esp)
    for _, obj in pairs(esp) do
        if type(obj) == "table" or (type(obj) == "userdata" and obj.Remove) then
            obj.Visible = false
            if pcall(function() return obj.Position end) then 
                obj.Position = HiddenVector
            elseif pcall(function() return obj.From end) then 
                obj.From = HiddenVector
                obj.To = HiddenVector 
            end
        end
    end
end
