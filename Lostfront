-- // 3. LOW-LEVEL VISUALS RENDER LOOP (PREMIUM SINGLE-COLOR UNBREAKABLE ESP)
local PlayerCache = _G.PlayerCache
local DroneCache = _G.DroneCache
local HiddenVector = Vector2.new(-10000, -10000)

-- Единый красивый неоновый цвет для всех игроков на карте
local PremiumPlayerColor = Color3.fromRGB(255, 20, 147) -- Неоново-розовый
local PremiumDroneColor = Color3.fromRGB(186, 85, 211)  -- Фиолетово-розовый неон

local function SetupPlayerESP(model)
    if PlayerCache[model] then return end
    PlayerCache[model] = {
        Box = NewDrawing("Square", { Thickness = 1, Color = PremiumPlayerColor, Visible = false }),
        Tracer = NewDrawing("Line", { Thickness = 1, Color = PremiumPlayerColor, Visible = false }),
        Name = NewDrawing("Text", { Size = 13, Center = true, Outline = true, Color = Color3.new(1,1,1), Visible = false }),
        Tag = NewDrawing("Text", { Size = 12, Center = true, Outline = true, Color = PremiumPlayerColor, Visible = false }),
        Health = NewDrawing("Line", { Thickness = 1.5, Visible = false }),
        HealthBg = NewDrawing("Line", { Thickness = 1.5, Color = Color3.new(0.1, 0.1, 0.1), Visible = false }),
        Spine = NewDrawing("Line", { Thickness = 1, Color = Color3.new(1,1,1), Visible = false }),
        LArm = NewDrawing("Line", { Thickness = 1, Color = Color3.new(1,1,1), Visible = false }),
        RArm = NewDrawing("Line", { Thickness = 1, Color = Color3.new(1,1,1), Visible = false }),
        LLeg = NewDrawing("Line", { Thickness = 1, Color = Color3.new(1,1,1), Visible = false }),
        RLeg = NewDrawing("Line", { Thickness = 1, Color = Color3.new(1,1,1), Visible = false })
    }
end

local function SetupDroneESP(model)
    if DroneCache[model] then return end
    DroneCache[model] = {
        Box = NewDrawing("Square", { Thickness = 1, Color = PremiumDroneColor, Visible = false }),
        Tracer = NewDrawing("Line", { Thickness = 1, Color = PremiumDroneColor, Visible = false }),
        Name = NewDrawing("Text", { Size = 13, Center = true, Outline = true, Color = PremiumDroneColor, Visible = false, Text = "[DRONE]" })
    }
end

RunService.RenderStepped:Connect(function()
    local root = Workspace:FindFirstChild("IIIIllllIIIllIIlIlI_IIllIlIIIllII_o")
    if not root then return end

    -- Просто собираем абсолютно всё, что лежит внутри главной папки обфускации
    for _, folder in ipairs(root:GetChildren()) do
        if folder:IsA("Folder") or folder:IsA("Model") then
            local folderName = folder.Name
            
            for _, child in ipairs(folder:GetChildren()) do
                if child:IsA("Model") and child.Name ~= LocalPlayer.Name then
                    SetupPlayerESP(child)
                    
                    local esp = PlayerCache[child]
                    if esp then
                        -- Сверху пишется точное имя папки, где сидит игрок
                        esp.Tag.Text = "[" .. tostring(folderName) .. "]"
                    end
                end
            end
        end
    end
    
    -- Скан Дронов в Workspace
    for _, child in ipairs(Workspace:GetChildren()) do
        if child:IsA("Model") and string.find(child.Name:lower(), "drone") then SetupDroneESP(child) end
    end

    -- --- ГРАФИЧЕСКИЙ КОНВЕЙЕР drawing api ---
    for model, esp in pairs(PlayerCache) do
        if not model or not model.Parent then
            ResetESP(esp); PlayerCache[model] = nil; continue
        end

        local torso = GetR6Part(model, "Torso")
        local head = GetR6Part(model, "Head")
        local hum = model:FindFirstChildOfClass("Humanoid")

        if Config.Players_Enabled and torso and head and hum and hum.Health > 0 then
            local torsoPos, onScreen = Camera:WorldToViewportPoint(torso.Position)
            if onScreen then
                local headPos = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0))
                local legPos = Camera:WorldToViewportPoint(torso.Position - Vector3.new(0, 3, 0))
                local boxHeight = math.abs(headPos.Y - legPos.Y)
                local boxWidth = boxHeight * 0.6
                local boxX = torsoPos.X - (boxWidth / 2)

                esp.Box.Size = Vector2.new(boxWidth, boxHeight)
                esp.Box.Position = Vector2.new(boxX, headPos.Y)
                esp.Box.Visible = Config.Players_Boxes

                esp.Tracer.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                esp.Tracer.To = Vector2.new(torsoPos.X, torsoPos.Y)
                esp.Tracer.Visible = Config.Players_Tracers

                esp.Tag.Position = Vector2.new(torsoPos.X, headPos.Y - 26)
                esp.Tag.Visible = Config.Players_TeamTags

                esp.Name.Text = model.Name
                esp.Name.Position = Vector2.new(torsoPos.X, headPos.Y - 14)
                esp.Name.Visible = Config.Players_Names

                if Config.Players_HealthBar then
                    local pct = hum.Health / hum.MaxHealth
                    esp.HealthBg.From = Vector2.new(boxX - 5, headPos.Y)
                    esp.HealthBg.To = Vector2.new(boxX - 5, headPos.Y + boxHeight)
                    esp.HealthBg.Visible = true
                    
                    esp.Health.From = Vector2.new(boxX - 5, headPos.Y + boxHeight)
                    esp.Health.To = Vector2.new(boxX - 5, headPos.Y + boxHeight - (boxHeight * pct))
                    esp.Health.Color = Color3.fromRGB(255,0,0):Lerp(Color3.fromRGB(0,255,0), pct)
                    esp.Health.Visible = true
                else
                    esp.Health.Visible = false; esp.HealthBg.Visible = false
                end

                if Config.Players_Skeletons then
                    local lArm = GetR6Part(model, "Left Arm")
                    local rArm = GetR6Part(model, "Right Arm")
                    local lLeg = GetR6Part(model, "Left Leg")
                    local rLeg = GetR6Part(model, "Right Leg")
                    
                    esp.Spine.From = Vector2.new(Camera:WorldToViewportPoint(head.Position).X, Camera:WorldToViewportPoint(head.Position).Y)
                    esp.Spine.To = Vector2.new(torsoPos.X, torsoPos.Y)
                    esp.Spine.Visible = true

                    if lArm then esp.LArm.From = Vector2.new(torsoPos.X, torsoPos.Y); esp.LArm.To = Vector2.new(Camera:WorldToViewportPoint(lArm.Position).X, Camera:WorldToViewportPoint(lArm.Position).Y); esp.LArm.Visible = true else esp.LArm.Visible = false end
                    if rArm then esp.RArm.From = Vector2.new(torsoPos.X, torsoPos.Y); esp.RArm.To = Vector2.new(Camera:WorldToViewportPoint(rArm.Position).X, Camera:WorldToViewportPoint(rArm.Position).Y); esp.RArm.Visible = true else esp.RArm.Visible = false end
                    if lLeg then esp.LLeg.From = Vector2.new(torsoPos.X, torsoPos.Y); esp.LLeg.To = Vector2.new(Camera:WorldToViewportPoint(lLeg.Position).X, Camera:WorldToViewportPoint(lLeg.Position).Y); esp.LLeg.Visible = true else esp.LLeg.Visible = false end
                    if rLeg then esp.RLeg.From = Vector2.new(torsoPos.X, torsoPos.Y); esp.RLeg.To = Vector2.new(Camera:WorldToViewportPoint(rLeg.Position).X, Camera:WorldToViewportPoint(rLeg.Position).Y); esp.RLeg.Visible = true else esp.RLeg.Visible = false end
                else
                    esp.Spine.Visible = false; esp.LArm.Visible = false; esp.RArm.Visible = false; esp.LLeg.Visible = false; esp.RLeg.Visible = false
                end
            else ResetESP(esp) end
        else ResetESP(esp) end
    end

    -- Отрисовка дронов
    for model, esp in pairs(DroneCache) do
        if not model or not model.Parent then
            ResetESP(esp); DroneCache[model] = nil; continue
        end

        local primary = model.PrimaryPart or model:FindFirstChildOfClass("BasePart")
        if Config.Drones_Enabled and primary then
            local pos, onScreen = Camera:WorldToViewportPoint(primary.Position)
            if onScreen then
                local s = 30
                esp.Box.Size = Vector2.new(s, s)
                esp.Box.Position = Vector2.new(pos.X - s/2, pos.Y - s/2)
                esp.Box.Visible = Config.Drones_Boxes

                esp.Tracer.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                esp.Tracer.To = Vector2.new(pos.X, pos.Y)
                esp.Tracer.Visible = Config.Drones_Tracers

                esp.Name.Position = Vector2.new(pos.X, pos.Y - s/2 - 12)
                esp.Name.Visible = Config.Drones_Names
            else ResetESP(esp) end
        else ResetESP(esp) end
    end
end)
