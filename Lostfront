local HiddenVector = Vector2.new(-10000, -10000)

local function NewDrawing(type, props)
    local obj = Drawing.new(type)
    for k, v in pairs(props) do obj[k] = v end
    return obj
end

local function ResetESP(esp)
    if not esp then return end
    if esp.Box then esp.Box.Visible = false; esp.Box.Position = HiddenVector end
    if esp.Tracer then esp.Tracer.Visible = false; esp.Tracer.From = HiddenVector; esp.Tracer.To = HiddenVector end
    if esp.Name then esp.Name.Visible = false; esp.Name.Position = HiddenVector end
    if esp.TeamLabel then esp.TeamLabel.Visible = false; esp.TeamLabel.Position = HiddenVector end
    if esp.Health then esp.Health.Visible = false; esp.Health.From = HiddenVector; esp.Health.To = HiddenVector end
    if esp.HealthBg then esp.HealthBg.Visible = false; esp.HealthBg.From = HiddenVector; esp.HealthBg.To = HiddenVector end
    if esp.Skeleton then
        for _, line in pairs(esp.Skeleton) do
            line.Visible = false
            line.From = HiddenVector
            line.To = HiddenVector
        end
    end
end

local function SetupPlayerESP(model)
    if PlayerCache[model] then return end
    local defaultColor = Color3.fromRGB(255, 20, 147)
    PlayerCache[model] = {
        Box = NewDrawing("Square", { Thickness = 1, Color = defaultColor, Visible = false }),
        Tracer = NewDrawing("Line", { Thickness = 1, Color = defaultColor, Visible = false }),
        Name = NewDrawing("Text", { Size = 13, Center = true, Outline = true, Color = Color3.new(1,1,1), Visible = false }),
        TeamLabel = NewDrawing("Text", { Size = 11, Center = true, Outline = true, Color = Color3.fromRGB(0, 255, 127), Visible = false, Text = "[СОЮЗНИК]" }),
        Health = NewDrawing("Line", { Thickness = 1.5, Visible = false }),
        HealthBg = NewDrawing("Line", { Thickness = 1.5, Color = Color3.new(0.1, 0.1, 0.1), Visible = false }),
        Skeleton = {
            Spine = NewDrawing("Line", { Thickness = 1, Color = Color3.new(1,1,1), Visible = false }),
            LArm = NewDrawing("Line", { Thickness = 1, Color = Color3.new(1,1,1), Visible = false }),
            RArm = NewDrawing("Line", { Thickness = 1, Color = Color3.new(1,1,1), Visible = false }),
            LLeg = NewDrawing("Line", { Thickness = 1, Color = Color3.new(1,1,1), Visible = false }),
            RLeg = NewDrawing("Line", { Thickness = 1, Color = Color3.new(1,1,1), Visible = false })
        }
    }
end

