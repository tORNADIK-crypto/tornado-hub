            ResetESP(esp)
            PlayerCache[model] = nil
            continue
        end

        if Config.Players_Enabled then
            local torso = model:FindFirstChild("Torso") or model:FindFirstChildOfClass("BasePart")
            local head = model:FindFirstChild("Head")
            local hum = model:FindFirstChildOfClass("Humanoid")

            local isAlive = true
            if hum and hum.Health <= 0 then isAlive = false end

            if torso and isAlive then
                local torsoPos, onScreen = Camera:WorldToViewportPoint(torso.Position)
                if onScreen then
                    local isTeammate = false
                    if MyTeamFolderName ~= "" and model.Parent and model.Parent.Name == MyTeamFolderName then
isTeammate = true
end
local boxHeight, boxWidth, boxX, headY
if head then
local headPos = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0))
local legPos = Camera:WorldToViewportPoint(torso.Position - Vector3.new(0, 3, 0))
boxHeight = math.abs(headPos.Y - legPos.Y)
boxWidth = boxHeight * 0.6
boxX = torsoPos.X - (boxWidth / 2)
headY = headPos.Y
else
boxHeight = 26
boxWidth = 26
boxX = torsoPos.X - 13
headY = torsoPos.Y - 13
end
esp.Box.Size = Vector2.new(boxWidth, boxHeight)
esp.Box.Position = Vector2.new(boxX, headY)
esp.Box.Visible = Config.Players_Boxes
esp.Tracer.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
esp.Tracer.To = Vector2.new(torsoPos.X, torsoPos.Y)
