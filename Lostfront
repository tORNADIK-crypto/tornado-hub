if isTeammate then
esp.TeamLabel.Position = Vector2.new(torsoPos.X, headY - 28)
esp.TeamLabel.Visible = true
else
esp.TeamLabel.Visible = false
end
if Config.Players_HealthBar and hum then
local pct = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
esp.HealthBg.From = Vector2.new(boxX - 5, headY)
esp.HealthBg.To = Vector2.new(boxX - 5, headY + boxHeight)
