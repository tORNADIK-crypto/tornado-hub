local function RenderToggle(text, configKey)
    local frame = Instance.new("Frame", ContentFrame)
    frame.Size = UDim2.new(1, 0, 0, 32)
    frame.BackgroundTransparency = 1
    
    local lbl = Instance.new("TextLabel", frame)
    lbl.Size = UDim2.new(0.7, 0, 1, 0)
    lbl.BackgroundTransparency = 1
    lbl.Text = text
    lbl.TextColor3 = Color3.fromRGB(230, 230, 230)
    lbl.Font = Enum.Font.SourceSansSemibold
    lbl.TextSize = 16
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    
    local tgl = Instance.new("TextButton", frame)
    tgl.Size = UDim2.new(0, 50, 0, 22)
    tgl.Position = UDim2.new(1, -50, 0.5, -11)
    tgl.BackgroundColor3 = Config[configKey] and Color3.fromRGB(255, 20, 147) or Color3.fromRGB(35, 35, 45)
    tgl.Text = Config[configKey] and "ON" or "OFF"
    tgl.TextColor3 = Color3.new(1,1,1)
    tgl.Font = Enum.Font.SourceSansBold
    tgl.TextSize = 12
    tgl.BorderSizePixel = 0
    
    Instance.new("UICorner", tgl).CornerRadius = UDim.new(0, 4)
    
    tgl.MouseButton1Click:Connect(function()
        Config[configKey] = not Config[configKey]
        tgl.Text = Config[configKey] and "ON" or "OFF"
        TweenService:Create(tgl, TweenInfo.new(0.15), {BackgroundColor3 = Config[configKey] and Color3.fromRGB(255, 20, 147) or Color3.fromRGB(35, 35, 45)}):Play()
    end)
end

local function RefreshTab()
    for _, c in ipairs(ContentFrame:GetChildren()) do if c:IsA("Frame") then c:Destroy() end end
    if Config.ActiveTab == "Visuals" then
        RenderToggle("Мастер ESP Включен", "Players_Enabled")
        RenderToggle("2D Квадраты (Boxes)", "Players_Boxes")
        RenderToggle("Линии (Tracers)", "Players_Tracers")
        RenderToggle("Отображать Ники (Names)", "Players_Names")
        RenderToggle("Полоса Здоровья (Health)", "Players_HealthBar")
        RenderToggle("Скелеты игроков", "Players_Skeletons")
    elseif Config.ActiveTab == "Aimbot" then
        RenderToggle("Аимлок на противников", "Aim_Enabled")
    end
end

local function CreateTabButton(text, yPos, tabTarget)
    local btn = Instance.new("TextButton", Sidebar)
    btn.Size = UDim2.new(1, -12, 0, 36)
    btn.Position = UDim2.new(0, 6, 0, yPos)
    btn.BackgroundColor3 = (Config.ActiveTab == tabTarget) and Color3.fromRGB(255, 20, 147) or Color3.fromRGB(25, 25, 35)
    btn.Text = text
    btn.TextColor3 = Color3.fromRGB(240, 240, 240)
    btn.Font = Enum.Font.SourceSansBold
    btn.TextSize = 14
    btn.BorderSizePixel = 0
    
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 5)
    
    btn.MouseButton1Up:Connect(function()
        Config.ActiveTab = tabTarget
        for _, child in ipairs(Sidebar:GetChildren()) do
            if child:IsA("TextButton") then child.BackgroundColor3 = (child == btn) and Color3.fromRGB(255, 20, 147) or Color3.fromRGB(25, 25, 35) end
        end
        RefreshTab()
    end)
end

CreateTabButton("ВИЗУАЛЫ", 15, "Visuals")
