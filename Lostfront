-- Конструктор кнопок шторки (Sidebar) с анимацией интерактивного сжатия
local function CreateTabButton(text, yPos, tabTarget)
    local btn = Instance.new("TextButton", Sidebar)
    btn.Size = UDim2.new(1, -12, 0, 36)
    btn.Position = UDim2.new(0, 6, 0, yPos)
    btn.BackgroundColor3 = (Config.ActiveTab == tabTarget) and Color3.fromRGB(255, 20, 147) or Color3.fromRGB(25, 25, 35)
    btn.Text = text
    btn.TextColor3 = Color3.fromRGB(240, 240, 240)
    btn.Font = Enum.Font.SourceSansBold
    btn.TextSize = 14
    btn.BorderSizePixel = 0
    
    local c = Instance.new("UICorner", btn)
    c.CornerRadius = UDim.new(0, 5)
    
    local origSize = btn.Size
    local origPos = btn.Position

    btn.MouseEnter:Connect(function()
        if Config.ActiveTab ~= tabTarget then
            TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(255, 20, 147)}):Play()
        end
    end)
    btn.MouseLeave:Connect(function()
        if Config.ActiveTab ~= tabTarget then
            TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(25, 25, 35)}):Play()
        end
    end)
    btn.MouseButton1Down:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.05), {
            Size = UDim2.new(origSize.X.Scale, origSize.X.Offset - 6, origSize.Y.Scale, origSize.Y.Offset - 4),
            Position = UDim2.new(origPos.X.Scale, origPos.X.Offset + 3, origPos.Y.Scale, origPos.Y.Offset + 2)
        }):Play()
    end)
    btn.MouseButton1Up:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.05), {Size = origSize, Position = origPos}):Play()
        Config.ActiveTab = tabTarget
        
        -- Сброс активного цвета у других вкладок
        for _, child in ipairs(Sidebar:GetChildren()) do
            if child:IsA("TextButton") and child ~= btn then
                child.BackgroundColor3 = Color3.fromRGB(25, 25, 35)
            end
        end
        btn.BackgroundColor3 = Color3.fromRGB(255, 20, 147)
        RefreshTab()
    end)
end

