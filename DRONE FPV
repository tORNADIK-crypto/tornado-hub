    if gpe then return end
    if input.KeyCode == Enum.KeyCode.RightShift then
        panel.Visible = not panel.Visible
    end
    if input.KeyCode == Enum.KeyCode.Q and droneActive then
        explodeDrone()
    end
    if input.KeyCode == Enum.KeyCode.T then
        setThermal(not thermalOn)
        btnThermal.Text = thermalOn and "THERMAL: ON" or "THERMAL: OFF"
        btnThermal.BackgroundColor3 = thermalOn and Color3.fromRGB(0, 150, 70) or Color3.fromRGB(80, 40, 140)
    end
end)

