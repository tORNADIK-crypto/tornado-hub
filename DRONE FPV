local function startDrone()
    if droneActive then setStatus("Already active", true); return end

    setStatus("Creating...")

    local ok, model, parts = pcall(createDroneModel)
    if not ok then
        setStatus("Model error!", true)
        warn("[DRONE] " .. tostring(model))
        return
    end

    droneActive = true
    droneModel = model
    droneParts = parts
    droneModel.Parent = Workspace

    local char = LP.Character
    local startCF = char and char:FindFirstChild("HumanoidRootPart")
        and char.HumanoidRootPart.CFrame * CFrame.new(0, 15, 0)
        or CFrame.new(0, 100, 0)

    local ok2, err2 = pcall(function()
        droneModel.PrimaryPart.CFrame = startCF
        updateVisual(startCF)
    end)
    if not ok2 then
        setStatus("Visual error!", true)
        warn("[DRONE] " .. tostring(err2))
        droneModel:Destroy()
        droneModel = nil
        droneActive = false
        return
    end

    velocity = Vector3.zero
    roll = 0
    tYaw, tPitch = 0, 0
    yaw, pitch = 0, 0

    Camera.CameraType = Enum.CameraType.Scriptable

    -- === Управление ===
    if platform == "pc" then
        UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
        UserInputService.MouseIconEnabled = false

        mouseConn = UserInputService.InputChanged:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseMovement and droneActive then
                tYaw = tYaw - input.Delta.X * CONFIG.RotSpeed
                tPitch = math.clamp(tPitch - input.Delta.Y * CONFIG.RotSpeed, -math.pi/2, math.pi/2)
            end
        end)
    else
        mobileGui.Enabled = true
        panel.Visible = false

        -- Свайп по экрану крутит камеру
        touchConn = UserInputService.TouchMoved:Connect(function(input, gpe)
            if gpe then return end
            if not droneActive then return end
            local delta = input.Delta
            tYaw = tYaw - delta.X * CONFIG.TouchRotSpeed
            tPitch = math.clamp(tPitch - delta.Y * CONFIG.TouchRotSpeed, -math.pi/2, math.pi/2)
        end)
    end

    collideConn = RunService.Heartbeat:Connect(function()
        if not droneActive or not droneModel then return end
        local base = droneModel.PrimaryPart
        local ray = Ray.new(base.Position, base.CFrame.LookVector * CONFIG.CollisionDist)
        local hit = Workspace:FindPartOnRay(ray, droneModel)
        if hit and not hit:IsDescendantOf(droneModel) and not hit:IsDescendantOf(LP.Character) then
            explodeDrone()
        end
    end)

    droneLoop = RunService.RenderStepped:Connect(function(dt)
        if not droneActive or not droneModel then return end

        local smooth = CONFIG.CamSmooth * (dt * 60)
        yaw = yaw + (tYaw - yaw) * smooth
        pitch = pitch + (tPitch - pitch) * smooth

        local spd = CONFIG.Speed
        local boost = false
        if platform == "pc" then
            boost = UserInputService:IsKeyDown(Enum.KeyCode.LeftShift)
        else
            boost = mobileInput.Boost
        end
        if boost then spd = spd * CONFIG.BoostMult end

        local rot = CFrame.Angles(0, yaw, 0) * CFrame.Angles(pitch, 0, 0)
        local fwd = rot.LookVector
        local right = rot.RightVector
        local up = Vector3.new(0, 1, 0)

        local inp = Vector3.zero
        if platform == "pc" then
            if UserInputService:IsKeyDown(Enum.KeyCode.W) then inp = inp + fwd end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then inp = inp - fwd end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then inp = inp + right; roll = roll + 0.05 end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then inp = inp - right; roll = roll - 0.05 end
            if UserInputService:IsKeyDown(Enum.KeyCode.Space) then inp = inp + up end
            if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then inp = inp - up end
        else
            if mobileInput.W then inp = inp + fwd end
            if mobileInput.S then inp = inp - fwd end
            if mobileInput.D then inp = inp + right; roll = roll + 0.05 end
            if mobileInput.A then inp = inp - right; roll = roll - 0.05 end
            if mobileInput.Up then inp = inp + up end
            if mobileInput.Down then inp = inp - up end
        end

        roll = math.clamp(roll, -CONFIG.FPVRoll, CONFIG.FPVRoll)
        local movingSide = (platform == "pc" and (UserInputService:IsKeyDown(Enum.KeyCode.D) or UserInputService:IsKeyDown(Enum.KeyCode.A)))
            or (platform == "mobile" and (mobileInput.D or mobileInput.A))
        if not movingSide then roll = roll * 0.9 end

        if inp.Magnitude > 0 then
            velocity = velocity:Lerp(inp.Unit * spd, CONFIG.Accel)
        else
            velocity = velocity * CONFIG.Decel
        end

        local newPos = droneModel.PrimaryPart.Position + velocity * dt
        local newCF = CFrame.new(newPos) * rot
        updateVisual(newCF)

        local shakeX = (math.random() - 0.5) * CONFIG.FPVShake * velocity.Magnitude / 100
        local shakeY = (math.random() - 0.5) * CONFIG.FPVShake * velocity.Magnitude / 100
        Camera.CFrame = CFrame.new(newCF.Position, newCF.Position + fwd)
            * CFrame.Angles(0, 0, roll + shakeX)
            * CFrame.new(shakeY, shakeY, 0)
    end)

    setStatus("Flying (" .. platform .. ")")
end

