local function createDroneModel()
    local model = Instance.new("Model")
    model.Name = "TornadoDrone"

    local function makePart(name, size, color, material, shape)
        local p = Instance.new("Part")
        p.Name = name
        p.Size = size
        p.BrickColor = color
        p.Material = material or Enum.Material.SmoothPlastic
        p.Anchored = true
        p.CanCollide = false
        p.Shape = shape or Enum.PartType.Block
        p.Parent = model
        return p
    end

    local bottomPlate = makePart("BottomPlate", Vector3.new(1.4, 0.08, 1.8), BrickColor.new("Really black"), Enum.Material.Metal)
    local topPlate = makePart("TopPlate", Vector3.new(1.2, 0.08, 1.6), BrickColor.new("Really black"), Enum.Material.Metal)

    local arms = {}
    for i = 1, 4 do
        table.insert(arms, makePart("Arm" .. i, Vector3.new(1.8, 0.06, 0.12), BrickColor.new("Really black"), Enum.Material.Metal))
    end

    local motors = {}
    for i = 1, 4 do
        table.insert(motors, makePart("Motor" .. i, Vector3.new(0.4, 0.3, 0.4), BrickColor.new("Dark stone grey"), Enum.Material.Metal))
    end

    local props = {}
    for i = 1, 4 do
        local blades = {}
        for b = 1, 2 do
            table.insert(blades, makePart("Blade" .. i .. "_" .. b, Vector3.new(1.5, 0.03, 0.08), BrickColor.new("Lime green"), Enum.Material.Neon))
        end
        table.insert(props, blades)
    end

    local camMount = makePart("CameraMount", Vector3.new(0.5, 0.4, 0.25), BrickColor.new("Really black"), Enum.Material.Metal)
    local lens = makePart("Lens", Vector3.new(0.28, 0.28, 0.28), BrickColor.new("Cyan"), Enum.Material.Neon, Enum.PartType.Ball)
    local battery = makePart("Battery", Vector3.new(0.7, 0.25, 1.2), BrickColor.new("Really black"), Enum.Material.SmoothPlastic)
    local antenna = makePart("Antenna", Vector3.new(0.06, 0.9, 0.06), BrickColor.new("Really black"), Enum.Material.SmoothPlastic)
    local led = makePart("LED", Vector3.new(0.12, 0.12, 0.12), BrickColor.new("Really red"), Enum.Material.Neon, Enum.PartType.Ball)

    model.PrimaryPart = bottomPlate
    return model, {
        bottomPlate = bottomPlate, topPlate = topPlate,
        arms = arms, motors = motors, props = props,
        camMount = camMount, lens = lens,
        battery = battery, antenna = antenna, led = led
    }
end

local function updateVisual(baseCF)
    if not droneModel or not droneModel.PrimaryPart then return end
    local p = droneParts

    p.bottomPlate.CFrame = baseCF
    p.topPlate.CFrame = baseCF * CFrame.new(0, 0.35, 0)

    local armAngles = {45, -45, 135, -135}
    for i, arm in ipairs(p.arms) do
        arm.CFrame = baseCF * CFrame.Angles(0, math.rad(armAngles[i]), 0) * CFrame.new(0.75, 0, 0)
    end

    local motorOffsets = {
        CFrame.new(1.05, 0.15, 1.05),
        CFrame.new(-1.05, 0.15, 1.05),
        CFrame.new(1.05, 0.15, -1.05),
        CFrame.new(-1.05, 0.15, -1.05),
    }
    local spinAngle = tick() * 40
    for i, motor in ipairs(p.motors) do
        motor.CFrame = baseCF * motorOffsets[i]
        p.props[i][1].CFrame = baseCF * motorOffsets[i] * CFrame.Angles(0, spinAngle, 0) * CFrame.new(0, 0.18, 0)
        p.props[i][2].CFrame = baseCF * motorOffsets[i] * CFrame.Angles(0, spinAngle + math.pi/2, 0) * CFrame.new(0, 0.18, 0)
    end

    p.camMount.CFrame = baseCF * CFrame.new(0, 0.15, 0.85) * CFrame.Angles(math.rad(-30), 0, 0)
    p.lens.CFrame = baseCF * CFrame.new(0, 0.3, 1.05) * CFrame.Angles(math.rad(-30), 0, 0)
    p.battery.CFrame = baseCF * CFrame.new(0, 0.55, -0.1)
    p.antenna.CFrame = baseCF * CFrame.new(0, 0.55, -0.85) * CFrame.Angles(math.rad(45), 0, 0)
    p.led.CFrame = baseCF * CFrame.new(0, -0.05, 0.7)
end

local function playSound(id, volume, position)
    local part = Instance.new("Part")
    part.Anchored = true
    part.CanCollide = false
    part.Transparency = 1
    part.Size = Vector3.new(0.1, 0.1, 0.1)
    part.Position = position or Vector3.new(0, 0, 0)
    part.Parent = Workspace
    local sound = Instance.new("Sound")
    sound.SoundId = id
    sound.Volume = volume or 1
    sound.Parent = part
    sound:Play()
    task.delay(6, function() part:Destroy() end)
end

local function explodeDrone()
    if not droneModel or not droneModel.PrimaryPart then return end
    local pos = droneModel.PrimaryPart.Position

    playSound(CONFIG.SoundExplosion, 3, pos)

    local explosion = Instance.new("Explosion")
    explosion.BlastRadius = CONFIG.ExplosionRadius
    explosion.BlastPressure = 0
    explosion.DestroyJointRadiusPercent = 0
    explosion.Position = pos
    explosion.Parent = Workspace

    local hitOnce = {}
    explosion.Hit:Connect(function(part, distance)
        local mdl = part.Parent
        if not mdl or hitOnce[mdl] then return end
        hitOnce[mdl] = true
        local hum = mdl:FindFirstChildOfClass("Humanoid")
        if hum and hum.Health > 0 then
            local factor = math.clamp(1 - distance / CONFIG.ExplosionRadius, 0, 1)
            hum:TakeDamage(CONFIG.ExplosionDamage * factor)
        end
    end)

    local fire = Instance.new("Part")
    fire.Size = Vector3.new(2, 2, 2)
    fire.Shape = Enum.PartType.Ball
    fire.BrickColor = BrickColor.new("Bright orange")
    fire.Material = Enum.Material.Neon
    fire.Anchored = true
    fire.CanCollide = false
    fire.Transparency = 0.3
    fire.Position = pos
    fire.Parent = Workspace
    local light = Instance.new("PointLight", fire)
    light.Brightness = 5
    light.Range = 20

    task.delay(0.5, function() fire:Destroy() end)
    task.delay(1, function() explosion:Destroy() end)

    if droneLoop then droneLoop:Disconnect(); droneLoop = nil end
    if mouseConn then mouseConn:Disconnect(); mouseConn = nil end
    if touchConn then touchConn:Disconnect(); touchConn = nil end
    if collideConn then collideConn:Disconnect(); collideConn = nil end
    droneModel:Destroy()
    droneModel = nil
    droneActive = false

    mobileGui.Enabled = false
    Camera.CameraType = Enum.CameraType.Custom
    if LP.Character then
        Camera.CameraSubject = LP.Character:FindFirstChildOfClass("Humanoid")
    end
    UserInputService.MouseBehavior = Enum.MouseBehavior.Default
    UserInputService.MouseIconEnabled = true

    if thermalOn then
        Lighting.Ambient = origAmbient
        Lighting.Brightness = origBrightness
    end
    setStatus("Exploded")
end

local function setThermal(state)
    thermalOn = state
    if state then
        origAmbient = Lighting.Ambient
        origBrightness = Lighting.Brightness
        Lighting.Ambient = Color3.fromRGB(255, 255, 255)
        Lighting.Brightness = 3
        Lighting.ClockTime = 14
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LP and plr.Character then
                for _, part in ipairs(plr.Character:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.Material = Enum.Material.Neon
                        part.Color = Color3.fromRGB(255, 255, 255)
                    end
                end
            end
        end
    else
        Lighting.Ambient = origAmbient
        Lighting.Brightness = origBrightness
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LP and plr.Character then
                for _, part in ipairs(plr.Character:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.Material = Enum.Material.Plastic
                    end
                end
            end
        end
    end
end

local function addESP(plr)
    if plr == LP then return end
    if not espFolder then return end
    if espFolder:FindFirstChild(plr.Name) then return end
    local function onChar(char)
        if not espOn then return end
        local old = espFolder:FindFirstChild(plr.Name)
        if old then old:Destroy() end
        local hl = Instance.new("Highlight")
        hl.Name = plr.Name
        hl.FillColor = CONFIG.ESPColor
        hl.OutlineColor = Color3.fromRGB(255, 255, 255)
        hl.FillTransparency = 0.5
        hl.OutlineTransparency = 0
        hl.Adornee = char
        hl.Parent = espFolder
    end
    if plr.Character then onChar(plr.Character) end
    plr.CharacterAdded:Connect(onChar)
end

local function setESP(state)
    espOn = state
    if state then
        espFolder = Instance.new("Folder")
        espFolder.Name = "DroneESP"
        espFolder.Parent = Workspace
        for _, plr in ipairs(Players:GetPlayers()) do addESP(plr) end
    else
        if espFolder then espFolder:Destroy(); espFolder = nil end
    end
end

