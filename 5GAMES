-- ФУНКЦИЯ ДЛЯ СУПЕР-КРАСИВЫХ АНИМАЦИЙ КНОПОК
local function applyNeonEffects(btn, isTabBtn)
    local stroke = Instance.new("UIStroke", btn)
    stroke.Thickness = 1.2
    stroke.Color = isTabBtn and Color3.fromRGB(35, 35, 45) or _G.ESP_COLOR
    
    local defaultColor = btn.BackgroundColor3
    local hoverColor = isTabBtn and Color3.fromRGB(24, 24, 32) or Color3.fromRGB(255, 130, 195)
    local pressColor = isTabBtn and Color3.fromRGB(32, 32, 45) or Color3.fromRGB(220, 70, 140)
    
    btn.MouseEnter:Connect(function()
        if btn:GetAttribute("Active") then return end
        TweenService:Create(btn, TweenInfo.new(0.25, Enum.EasingStyle.Cubic, Enum.EasingDirection.Out), {
            BackgroundColor3 = hoverColor,
            Size = btn.Size + UDim2.fromOffset(isMobile and 2 or 4, 0)
        }):Play()
        if isTabBtn then TweenService:Create(stroke, TweenInfo.new(0.2), {Color = _G.ESP_COLOR}):Play() end
    end)
    
    btn.MouseLeave:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            BackgroundColor3 = btn:GetAttribute("Active") and _G.ESP_COLOR or defaultColor,
            Size = btn.Size - UDim2.fromOffset(isMobile and 2 or 4, 0)
        }):Play()
        if isTabBtn and not btn:GetAttribute("Active") then TweenService:Create(stroke, TweenInfo.new(0.2), {Color = Color3.fromRGB(35, 35, 45)}):Play() end
    end)
    
    btn.MouseButton1Down:Connect(function() TweenService:Create(btn, TweenInfo.new(0.1), {BackgroundColor3 = pressColor}):Play() end)
end

