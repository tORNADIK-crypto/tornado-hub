        p.Visible = false
    end
    if AboutPage then
        AboutPage.Visible = false
    end
    
    targetBtn:SetAttribute("Active", true)
    targetBtn.BackgroundColor3 = ACCENT_COLOR
    targetBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    local st = targetBtn:FindFirstChildOfClass("UIStroke")
    if st then st.Color = Color3.fromRGB(255, 150, 210) end
    
    targetPage.Visible = true
    activePage = pageName
end

