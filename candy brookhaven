local ToggleBtn = _G.ToggleBtn
local TpBtn = _G.TpBtn
local BrookhavenEspBtn = _G.BrookhavenEspBtn
local ResetBtn = _G.ResetBtn
local EspFolder = _G.EspFolderObject

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")

local function jitterMovement()
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if hrp then
        hrp.CFrame = hrp.CFrame * CFrame.new(0, 0, 2) task.wait(0.15)
        hrp.CFrame = hrp.CFrame * CFrame.new(0, 0, -4) task.wait(0.15)
        hrp.CFrame = hrp.CFrame * CFrame.new(0, 0, 2)
    end
end

local function updateESP()
    EspFolder:ClearAllChildren()
    if not _G.espActive or not _G.candyFolder then return end
    for _, candy in pairs(_G.candyFolder:GetChildren()) do
        if (candy:IsA("BasePart") or candy:IsA("MeshPart")) and not _G.visitedCandies[candy.Name] then
            local box = Instance.new("BoxHandleAdornment", EspFolder)
            box.Size = candy.Size + Vector3.new(0.5, 0.5, 0.5)
            box.AlwaysOnTop = true box.ZIndex = 5 box.Color3 = Color3.fromRGB(255, 120, 0)
            box.Adornee = candy box.Transparency = 0.4

            local bGui = Instance.new("BillboardGui", EspFolder)
            bGui.Size = UDim2.new(0, 100, 0, 30) bGui.AlwaysOnTop = true bGui.Adornee = candy bGui.StudsOffset = Vector3.new(0, 3, 0)
            local label = Instance.new("TextLabel", bGui)
            label.Size = UDim2.new(1, 0, 1, 0) label.BackgroundTransparency = 1 label.Text = candy.Name
            label.TextColor3 = Color3.fromRGB(255, 255, 255) label.TextStrokeTransparency = 0 label.TextSize = 12
            label.Font = Enum.Font.SourceSansBold
        end
    end
end

local function getNextCandy()
    if not _G.candyFolder then return nil end
    for _, candy in pairs(_G.candyFolder:GetChildren()) do
        if candy:IsA("BasePart") or candy:IsA("MeshPart") or candy:IsA("Model") then
            if not _G.visitedCandies[candy.Name] then return candy end
        end
    end
    return nil
end

local function flyToCFrame(targetCFrame)
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end
    local duration = (hrp.Position - targetCFrame.Position).Magnitude / 120
    local tween = TweenService:Create(hrp, TweenInfo.new(duration, Enum.EasingStyle.Linear), {CFrame = targetCFrame})
    tween:Play() tween.Completed:Wait()
    return true
end

local function collectCandy(candy)
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if hrp and candy and candy.Parent then
        local targetCFrame = candy:IsA("Model") and (candy:GetPrimaryPartCFrame() or candy:FindFirstChildWhichIsA("BasePart").CFrame) or candy.CFrame
        if targetCFrame then
            _G.noclipOn = false flyToCFrame(targetCFrame + Vector3.new(0, 1.5, 0)) task.wait(0.2)
            jitterMovement()
            local startTime = tick()
            local collected = false
            while tick() - startTime < 2 do
                if not candy or not candy.Parent then collected = true break end
                task.wait(0.1)
            end
            if not collected and candy and candy.Parent then
                _G.noclipOn = true hrp.CFrame = targetCFrame jitterMovement() task.wait(0.5) _G.noclipOn = false
            end
            _G.visitedCandies[candy.Name] = true
            if _G.espActive then updateESP() end
        end
    end
end

ToggleBtn.MouseButton1Click:Connect(function()
    _G.autoCollecting = not _G.autoCollecting
    if _G.autoCollecting then
        ToggleBtn.Text = "Авто-сбор: ВКЛ" ToggleBtn.BackgroundColor3 = Color3.fromRGB(34, 139, 34)
        task.spawn(function()
            while _G.autoCollecting do
                local candy = getNextCandy()
                if candy then collectCandy(candy) else table.clear(_G.visitedCandies) if _G.espActive then updateESP() end end
                task.wait(0.5)
            end
        end)
    else
        ToggleBtn.Text = "Авто-сбор: ВЫКЛ" ToggleBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 55) _G.noclipOn = false
    end
end)

TpBtn.MouseButton1Click:Connect(function() if not _G.autoCollecting then local candy = getNextCandy() if candy then collectCandy(candy) end end end)
BrookhavenEspBtn.MouseButton1Click:Connect(function()
    _G.espActive = not _G.espActive
    BrookhavenEspBtn.Text = _G.espActive and "Подсветка (ESP): ВКЛ" or "Подсветка (ESP): ВЫКЛ"
    BrookhavenEspBtn.BackgroundColor3 = _G.espActive and Color3.fromRGB(255, 140, 0) or Color3.fromRGB(50, 50, 55)
    if _G.espActive then updateESP() else EspFolder:ClearAllChildren() end
end)
ResetBtn.MouseButton1Click:Connect(function()
    table.clear(_G.visitedCandies) if _G.espActive then updateESP() end
    local oldText = ResetBtn.Text ResetBtn.Text = "Очищено!" task.wait(1.5) ResetBtn.Text = oldText
end)
if _G.candyFolder then _G.candyFolder.ChildRemoved:Connect(function() if _G.espActive then updateESP() end end) end

RunService.Stepped:Connect(function()
