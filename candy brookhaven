local ToggleBtn = Instance.new("TextButton", CandyFrame)
local TpBtn = Instance.new("TextButton", CandyFrame)
local BrookhavenEspBtn = Instance.new("TextButton", CandyFrame)
local ResetBtn = Instance.new("TextButton", CandyFrame)

