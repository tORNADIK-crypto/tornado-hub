task.wait(0.1)

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")

-- Переменные для Брукхейвена
local autoCollecting = false
local espActive = false
local visitedCandies = {}
local noclipOn = false
local candyFolder = workspace:FindFirstChild("CandyCornHunt") and workspace.CandyCornHunt:FindFirstChild("Week1")

local EspFolder = Instance.new("Folder")
EspFolder.Name = "CandyESP"
EspFolder.Parent = coreGui

