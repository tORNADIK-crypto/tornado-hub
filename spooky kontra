_G.ChoNax4RenderPlayers = function(models, myRoot, MainMenuObj, WatermarkObj)
    local activePlayers = {}

    for _, model in ipairs(models) do
        local root = model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("Head") or model.PrimaryPart
        if root and model.Parent then
            local containerName = "Holder_" .. model.Name
            activePlayers[containerName .. "_Box"] = true
            
            local top3D = root.Position + Vector3.new(0, 2.3, 0)
            local bottom3D = root.Position - Vector3.new(0, 3.2, 0)
            local topScreen, topOnScreen = Camera:WorldToViewportPoint(top3D)
            local bottomScreen, bottomOnScreen = Camera:WorldToViewportPoint(bottom3D)
            
            local box, hpBg, hpBar, tracer, info = _G.GetOrCreateHyperContainer(model)
            
            if topOnScreen and bottomOnScreen and box then
                local targetUserId = model:GetAttribute("UserId") or (model:FindFirstChild("UserId") and model.UserId.Value)
                local teamType = _G.GetKontraTeamType(model, targetUserId)
                local stroke = box:FindFirstChildOfClass("UIStroke")
                
                local sizeY = math.abs(topScreen.Y - bottomScreen.Y)
                local sizeX = sizeY * 0.55
                local posX = topScreen.X - sizeX / 2
                local posY = topScreen.Y
                
                local currentHp = model:GetAttribute("Health") or 100
                local hum = model:FindFirstChildOfClass("Humanoid")
                if hum then currentHp = hum.Health 
                elseif model:FindFirstChild("Health") and model.Health:IsA("ValueBase") then currentHp = model.Health.Value end
                
                local weaponName = "Нож"
                local activeTool = model:FindFirstChildOfClass("Tool")
                if activeTool then weaponName = activeTool.Name end
                
                local distanceInSteps = myRoot and math.floor((root.Position - myRoot.Position).Magnitude) or 0
                local mainColor = Color3.fromRGB(0, 130, 255)
                
                if teamType == "Enemy" then
                    local isVisible = _G.CheckKontraVisibility(model, root)
                    mainColor = isVisible and Color3.fromRGB(165, 40, 255) or Color3.fromRGB(85, 20, 135)
                end

                box.Size = UDim2.fromOffset(sizeX, sizeY)
                box.Position = UDim2.fromOffset(posX, posY)
                box.BackgroundColor3 = mainColor
                if stroke then stroke.Color = mainColor end
                box.Visible = true

                if teamType == "Enemy" then
                    local startX = Camera.ViewportSize.X / 2 
                    local startY = Camera.ViewportSize.Y
                    local direction = Vector2.new(bottomScreen.X - startX, bottomScreen.Y - startY)
                    tracer.Size = UDim2.fromOffset(direction.Magnitude, 1.5)
                    tracer.Position = UDim2.fromOffset(startX, startY)
                    tracer.Rotation = math.deg(math.atan2(direction.Y, direction.X))
                    tracer.BackgroundColor3 = mainColor 
                    tracer.BackgroundTransparency = 0.5 
                    tracer.Visible = true
                else tracer.Visible = false end

                local barHpHeight = sizeY * (math.clamp(currentHp, 0, 100) / 100)
                hpBg.Size = UDim2.fromOffset(2.5, sizeY) 
                hpBg.Position = UDim2.fromOffset(posX - 6, posY) 
                hpBg.Visible = true
                
                hpBar.Size = UDim2.fromOffset(2.5, barHpHeight) 
                hpBar.Position = UDim2.fromOffset(posX - 6, posY + (sizeY - barHpHeight))
                hpBar.BackgroundColor3 = Color3.fromRGB(255 - (currentHp * 2.55), currentHp * 2.55, 180) 
                hpBar.Visible = true

                info.Size = UDim2.fromOffset(sizeX + 100, 20) 
                info.Position = UDim2.fromOffset(posX - 50, posY + sizeY + 2)
                info.Text = string.format("%s | %d Шагов", string.upper(tostring(weaponName)), distanceInSteps) 
                info.TextColor3 = mainColor 
                info.Visible = true
            else
                if box then box.Visible = false end if hpBg then hpBg.Visible = false end if hpBar then hpBar.Visible = false end if tracer then tracer.Visible = false end if info then info.Visible = false end
            end
        end
    end

    for _, child in ipairs(PremiumGui:GetChildren()) do
        if child.Name:match("^Holder_") and (child:IsA("Frame") or child:IsA("TextLabel")) and child ~= MainMenuObj and child ~= WatermarkObj then
            local pName = child.Name:match("^(Holder_.+)_%a+$") or child.Name:match("^(Holder_.+)_%a+%a+$")
            if pName and not activePlayers[pName .. "_Box"] then child.Visible = false end
        end
    end
end

