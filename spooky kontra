_G.ChoNax4RenderItems = function(groundWeapons, smokeObjects, flashObjects, myRoot)
    -- 🌫 БЕЗКОМПРОМИССНОЕ УНИЧТОЖЕНИЕ ДЫМА: Стираем партикли, меши, прозрачность и вложенные текстуры
    if _G.KONTRAA_NOSMOKE_ENABLED and #smokeObjects > 0 then
        for _, smoke in ipairs(smokeObjects) do
            pcall(function()
                if smoke:IsA("Smoke") then 
                    smoke.Enabled = false 
                    smoke.Opacity = 0
                elseif smoke:IsA("ParticleEmitter") then 
                    smoke.Enabled = false 
                    smoke:Clear()
                elseif smoke:IsA("BasePart") then 
                    smoke.Transparency = 1 
                    smoke.LocalTransparencyModifier = 1
                    smoke.CanCollide = false
                end
                
                -- Глубокая зачистка вложенных слоев дымовой модели от ParticleHandler шутера
                for _, child in ipairs(smoke:GetDescendants()) do
                    if child:IsA("BasePart") or child:IsA("Decal") or child:IsA("Texture") or child:IsA("MeshPart") then
                        child.Transparency = 1
                        child.LocalTransparencyModifier = 1
                    elseif child:IsA("ParticleEmitter") or child:IsA("Smoke") then
                        child.Enabled = false
                        child:Clear()
                    end
                end
            end)
        end
    end

    -- ⚡ Защита от ослепления (Anti-Flash)
    if _G.KONTRAA_ANTIFLASH_ENABLED then
        if #flashObjects > 0 then
            for _, obj in ipairs(flashObjects) do
                pcall(function() 
                    if obj:IsA("BlurEffect") then 
                        obj.Size = 0 
                    else 
                        obj.Brightness = 0 
                        obj.Contrast = 0 
                        obj.Saturation = 0 
                    end 
                end)
            end
        end
        local pGui = game:GetService("Players").LocalPlayer:FindFirstChild("PlayerGui")
        if pGui then
            for _, guiElement in ipairs(pGui:GetChildren()) do
                if guiElement:IsA("ScreenGui") and (guiElement.Name:lower():match("flash") or guiElement.Name:lower():match("blind")) then
                    pcall(function() guiElement.Enabled = false end)
                end
            end
        end
    end

    -- 🔫 Отрисовка оружия на полу (Item ESP)
    local activeItems = {}
    for _, item in ipairs(groundWeapons) do
        local primaryPart = item:IsA("Model") and item.PrimaryPart or item
        if primaryPart and item.Parent then
            local labelName = "ItemLabel_" .. item.Name 
            activeItems[labelName] = true
            
            local itemPos, itemOnScreen = Camera:WorldToViewportPoint(primaryPart.Position)
            local itemLabel = getOrCreateItemLabel(item)
            
            if itemOnScreen then
                local groundWeaponName = item:GetAttribute("WeaponName") or item.Name
                local distToItem = myRoot and math.floor((primaryPart.Position - myRoot.Position).Magnitude) or 0
                
                itemLabel.Size = UDim2.fromOffset(200, 20) 
                itemLabel.Position = UDim2.fromOffset(itemPos.X - 100, itemPos.Y - 10)
                itemLabel.Text = string.format("• %s [%d Ш] •", string.upper(tostring(groundWeaponName)), distToItem) 
                itemLabel.Visible = true
            else itemLabel.Visible = false end
        end
    end

    -- Очистка шлейфов подобранных предметов
    for _, child in ipairs(_G.ChoNax4Gui:GetChildren()) do
        if child:IsA("TextLabel") and child.Name:match("^ItemLabel_") and not activeItems[child.Name] then 
            child.Visible = false 
        end
    end
end

