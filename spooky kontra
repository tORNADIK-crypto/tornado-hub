-- Трёхлучевой адаптивный Raycast-фильтр для динамического сканирования укрытий
_G.CheckKontraVisibility = function(model, root)
    local myChar = LocalPlayer.Character or workspace:FindFirstChild(LocalPlayer.Name, true)
    if not myChar or not myChar:FindFirstChild("HumanoidRootPart") then return false end
    
    local raycastParams = RaycastParams.new()
    raycastParams.FilterType = Enum.RaycastFilterType.Exclude
    raycastParams.FilterDescendantsInstances = {myChar, model, Camera, workspace.Terrain}
    raycastParams.IgnoreWater = true
    
    local origin = Camera.CFrame.Position
    local headPos = root.Position + Vector3.new(0, 2, 0)
    local torsoPos = root.Position
    local legsPos = root.Position - Vector3.new(0, 2.3, 0)
    
    for _, targetPoint in ipairs({headPos, torsoPos, legsPos}) do
        local direction = targetPoint - origin
        local result = workspace:Raycast(origin, direction, raycastParams)
        if not result or (result.Instance and result.Instance.CanCollide == false) then
            return true -- Противник виден напрямую или за простреливаемой текстурой
        end
    end
    return false
end

-- Извлечённый из ядра игры 100% фикс детекции команд по реальному UserId сущности
_G.GetKontraTeamType = function(model, targetUserId)
    if targetUserId then
        local targetPlayer = Players:GetPlayerByUserId(targetUserId)
        if targetPlayer then
            if targetPlayer == LocalPlayer then return "Friendly" end
            if targetPlayer.Team == LocalPlayer.Team then
                return "Friendly" -- Официальный тиммейт матча по Roblox Team
            else
                return "Enemy" -- 100% Гарантированный противник
            end
        end
    end

    -- Резервные алгоритмы проверки на случай сетевой рассинхронизации пакетов игры
    if model:FindFirstChild("Leaderboard") and (model.Leaderboard:FindFirstChild("FriendlyIndicator") or model.Leaderboard:FindFirstChild("TeamColor")) then
        return "Friendly"
    end
    local radar = LocalPlayer:FindFirstChild("PlayerGui") and LocalPlayer.PlayerGui:FindFirstChild("Radar")
    if radar and radar:FindFirstChild(model.Name) then return "Friendly" end
    
    local myChar = LocalPlayer.Character or workspace:FindFirstChild(LocalPlayer.Name, true)
    if myChar and myChar.Parent and model.Parent == myChar.Parent and model.Parent.Name ~= "Characters" then
        return "Friendly"
    end
    
    return "Enemy"
end

