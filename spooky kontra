                local targetUserId = model:GetAttribute("UserId") or (model:FindFirstChild("UserId") and model.UserId.Value)
                local teamType = _G.GetKontraTeamType(model, targetUserId)
                local stroke = box:FindFirstChildOfClass("UIStroke")
                
                local sizeY = math.abs(topScreen.Y - bottomScreen.Y)
                local sizeX = sizeY * 0.55
                local posX = topScreen.X - sizeX / 2
                local posY = topScreen.Y
                
                -- Отказоустойчивый сбор ХП и оружия
                local currentHp = model:GetAttribute("Health") or 100
                local hum = model:FindFirstChildOfClass("Humanoid")
                if hum then currentHp = hum.Health 
                elseif model:FindFirstChild("Health") and model.Health:IsA("ValueBase") then currentHp = model.Health.Value
                elseif model:FindFirstChild("hp") and model.hp:IsA("ValueBase") then currentHp = model.hp.Value end
                
                local weaponName = "Нож"
                local ccw = model:FindFirstChild("CharacterCurrentWeapon") or model:GetAttribute("CharacterCurrentWeapon")
                local activeTool = model:FindFirstChildOfClass("Tool")
                if ccw and type(ccw) == "table" and ccw.Name then weaponName = ccw.Name
                elseif activeTool then weaponName = activeTool.Name end
                
                local distanceInSteps = myRoot and math.floor((root.Position - myRoot.Position).Magnitude) or 0

                -- Цвета палитры Luxury Purple
                local mainColor = Color3.fromRGB(0, 130, 255) -- Синий союзник
                
                if teamType == "Enemy" then
                    local isVisible = _G.CheckKontraVisibility(model, root)
                    mainColor = isVisible and Color3.fromRGB(165, 40, 255) or Color3.fromRGB(85, 20, 135)
                    
                    -- Фильтрация валидной цели для Аима (Абсолютный захват ближайшего к прицелу врага внутри FOV круга)
                    if _G.KONTRAA_AIMBOT_ENABLED and currentHp > 0 then
                        local screenCenter = Camera.ViewportSize / 2
                        local mouseDist = (Vector2.new(topScreen.X, topScreen.Y + sizeY / 2) - screenCenter).Magnitude
                        if mouseDist <= AimFOV.Radius and mouseDist < closestDistance then
                            closestDistance = mouseDist
                            closestTarget = root
                        end
                    end
                end

                -- ОТРЕСОВКА: Квадрат хитбокса
                box.Size = UDim2.fromOffset(sizeX, sizeY)
                box.Position = UDim2.fromOffset(posX, posY)
                box.BackgroundColor3 = mainColor
                if stroke then stroke.Color = mainColor end
                box.Visible = true

                -- ОТРЕСОВКА: Трейсеры из центра низа экрана к стопам
                if teamType == "Enemy" then
                    local startX = Camera.ViewportSize.X / 2
                    local startY = Camera.ViewportSize.Y
                    local direction = Vector2.new(bottomScreen.X - startX, bottomScreen.Y - startY)
                    local tracerDistance = direction.Magnitude
                    local angle = math.deg(math.atan2(direction.Y, direction.X))
                    
                    tracer.Size = UDim2.fromOffset(tracerDistance, 1.5)
                    tracer.Position = UDim2.fromOffset(startX, startY)
                    tracer.Rotation = angle
                    tracer.BackgroundColor3 = mainColor
                    tracer.BackgroundTransparency = 0.5
                    tracer.Visible = true
                else
                    tracer.Visible = false
                end

                -- ОТРЕСОВКА: Адаптивное ХП (Слева от рамки)
                local barHpHeight = sizeY * (math.clamp(currentHp, 0, 100) / 100)
                local hpOffsetX = posX - 6
                
                hpBg.Size = UDim2.fromOffset(2.5, sizeY)
                hpBg.Position = UDim2.fromOffset(hpOffsetX, posY)
                hpBg.Visible = true
                
                hpBar.Size = UDim2.fromOffset(2.5, barHpHeight)
                hpBar.Position = UDim2.fromOffset(hpOffsetX, posY + (sizeY - barHpHeight))
                hpBar.BackgroundColor3 = Color3.fromRGB(255 - (currentHp * 2.55), currentHp * 2.55, 180)
                hpBar.Visible = true

                -- ОТРЕСОВКА: Текст Оружия и Шагов (Снизу рамки)
                info.Size = UDim2.fromOffset(sizeX + 100, 20)
                info.Position = UDim2.fromOffset(posX - 50, posY + sizeY + 2)
                info.Text = string.format("%s | %d Шагов", string.upper(weaponName), distanceInSteps)
                info.TextColor3 = mainColor
                info.Visible = true
            else
                if box then box.Visible = false end
                if hpBg then hpBg.Visible = false end
                if hpBar then hpBar.Visible = false end
                if tracer then tracer.Visible = false end
                if info then info.Visible = false end
            end
        end
    end

    -- Передаем найденную цель для жесткого аимлока в глобальную область
    _G.ChoNax4AimbotTarget = closestTarget

    -- Очистка шлейфов мертвых/вышедших игроков
    for _, child in pairs(PremiumGui:GetChildren()) do 
        if child:IsA("Frame") and child ~= MainMenu and child ~= Watermark and child.Name:match("^Holder_") then 
            local primaryName = child.Name:match("^(Holder_.+)_%a+$") or child.Name:match("^(Holder_.+)_%a+%a+$")
            if primaryName and not activePlayers[primaryName .. "_Box"] then child.Visible = false end 
        elseif child:IsA("TextLabel") and child ~= MainMenu and child ~= Watermark and child.Name:match("^Holder_") then 
            local primaryName = child.Name:match("^(Holder_.+)_%a+$")
            if primaryName and not activePlayers[primaryName .. "_Box"] then child.Visible = false end 
        end 
    end
