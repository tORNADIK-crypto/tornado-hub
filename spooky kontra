-- ИЗОЛИРОВАННЫЙ МОДУЛЬ 2: PRIVATE HARD VECTOR AIMLOCK (ПК: клавиша 'E' | МОБИЛКА: ЗАЖИМ В FOV)
_G.ChoNax4ProcessAimbot = function()
    local targetRoot = _G.ChoNax4AimbotTarget
    if not _G.KONTRAA_AIMBOT_ENABLED or not targetRoot then return end

    local isAimKeyPressed = UserInputService:IsKeyDown(Enum.KeyCode.E) -- Удержание E на ПК
    local isScreenTouched = UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) -- Зажим на мобилке
    
    -- Фильтр мобильного тапа в зоне FOV круга
    if isScreenTouched and UserInputService.TouchEnabled then
        local touchLocation = UserInputService:GetMouseLocation()
        local screenCenter = Camera.ViewportSize / 2
        if (touchLocation - screenCenter).Magnitude > AimFOV.Radius then
            isScreenTouched = false 
        end
    elseif UserInputService.TouchEnabled then
        isScreenTouched = false
    end

    -- Жесткая векторная фиксация взгляда камеры (Железный обход возврата CFrame)
    if isAimKeyPressed or isScreenTouched then
        local head = targetRoot.Parent:FindFirstChild("Head") or targetRoot
        local headScreenPos, headOnScreen = Camera:WorldToViewportPoint(head.Position)
        if headOnScreen then
            -- Принудительное перебивание кастомного CharacterController игры через CoordinateFrame
            pcall(function()
                Camera.CFrame = CFrame.new(Camera.CFrame.Position, head.Position)
            end)
        end
    end
end

