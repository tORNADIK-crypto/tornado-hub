                task.wait(_G.AntiCheatDelay)
                if not _G.AutofarmEnabled then break end
                if not localPlayer.Character or not localPlayer.Character:FindFirstChild("HumanoidRootPart") then continue end
                
                -- Шаг 2: ТП на Dropoff и сдача
                instantTeleport(savedDropoffCFrame)
                task.wait(0.35)
                pressEThreeTimes()
                task.wait(0.15)
                if not _G.AutofarmEnabled then break end
                task.wait(0.1)
                
                -- Авто-сброс (килл) персонажа для обнуления хвостов
                if humanoid and humanoid.Health > 0 then
                    camera.CameraType = Enum.CameraType.Custom
                    camera.CameraSubject = humanoid
                    task.wait(0.01)
                    humanoid.Health = 0
                end
                
                -- Ожидание респавна перед следующим заказом
                localPlayer.CharacterAdded:Wait()
                local newChar = localPlayer.Character or localPlayer.CharacterAdded:Wait()
                newChar:WaitForChild("HumanoidRootPart", 10)
                task.wait(0.1)
            end
        end)
    else
        _G.AutofarmEnabled = false
        _G.AutofarmButton.Text = "АВТО ФАРМ: ВЫКЛ"
        _G.AutofarmButton.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
    end
end)
