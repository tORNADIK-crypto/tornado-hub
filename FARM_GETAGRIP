end

local function instantTeleport(targetCFrame)
    local character = localPlayer.Character or localPlayer.CharacterAdded:Wait()
    local rootPart = character:WaitForChild("HumanoidRootPart", 5)
    if not rootPart then return end
    local targetPos = targetCFrame.Position + Vector3.new(0, 2, 0)
    localPlayer:RequestStreamAroundAsync(targetPos)
    local tween = TweenService:Create(rootPart, TweenInfo.new(0.02, Enum.EasingStyle.Linear), {CFrame = CFrame.new(targetPos)})
    tween:Play()
    tween.Completed:Wait()
end

local function findDropoff()
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj.Name == "DropoffPoints" then
            local part = obj:FindFirstChild("Part", true) or obj:FindFirstChildWhichIsA("BasePart", true)
            if part then return part end
        end
    end
    return nil
end

local function findPickup()
    local pickupFolder = workspace:FindFirstChild("Pickup")
    if pickupFolder then return pickupFolder:FindFirstChildWhichIsA("BasePart", true) or (pickupFolder:IsA("BasePart") and pickupFolder) end
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj.Name == "Pickup" then return obj:FindFirstChildWhichIsA("BasePart", true) or (obj:IsA("BasePart") and obj) end
    end
    return nil
end

-- Полный перечень оставшихся вещей (300+300+300+300+500+350 = 2450 монет)
local totalShopCoinsCost = 2450
local leaderstats = localPlayer:WaitForChild("leaderstats", 10)
local moneyValue = leaderstats and (leaderstats:FindFirstChild("Money") or leaderstats:FindFirstChild("Cash") or leaderstats:FindFirstChild("Dollars") or leaderstats:FindFirstChildWhichIsA("ValueBase"))

local totalEarned = 0
local maxSingleEarned = 0
local startTime = os.time()
local lastMoney = moneyValue and moneyValue.Value or 0

local function refreshCost(val)
    local needed = totalShopCoinsCost - val
    if needed < 0 then needed = 0 end
    if _G.CostAllLabel then _G.CostAllLabel.Text = "До полной скупочки магазина: $"..needed end
end
if moneyValue then refreshCost(moneyValue.Value) end

if moneyValue then
    moneyValue.Changed:Connect(function(newVal)
        refreshCost(newVal)
        if newVal > lastMoney then
            local gained = newVal - lastMoney
            totalEarned = totalEarned + gained
            if gained > maxSingleEarned and gained <= 5000 then maxSingleEarned = gained end
            if _G.TotalEarnedLabel then _G.TotalEarnedLabel.Text = "Заработано: $" .. totalEarned end
            if _G.MaxEarnedLabel then _G.MaxEarnedLabel.Text = "Макс. за заказ: $" .. maxSingleEarned end
        end
        lastMoney = newVal
    end)
end

