local totalEarned = 0
local maxSingleEarned = 0
local lastMoney = moneyValue and moneyValue.Value or 0

local function refreshCost(val)
    local needed = totalShopCoinsCost - val
    if needed < 0 then needed = 0 end
    if _G.CostAllLabel then _G.CostAllLabel.Text = "До полной скупочки магазина: $"..needed end
end
