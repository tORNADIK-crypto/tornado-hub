-- АВТОМАТИЧЕСКИЙ ОБХОД ЗАЩИТЫ АФК (ANTI-AFK BYPASS)
-- Работает в фоне всегда, когда включен автофарм, каждые 60 секунд имитирует прыжок
task.spawn(function()
    while true do
        task.wait(60) -- Проверка каждую минуту
        if _G.AutofarmEnabled then
            pcall(function()
                local char = localPlayer.Character
                local hum = char and char:FindFirstChildOfClass("Humanoid")
                local root = char and char:FindFirstChild("HumanoidRootPart")
                if hum and root and hum.Health > 0 then
                    -- Безопасный прыжок без нарушения позиции телепорта
                    hum.Jump = true
                    task.wait(0.2)
                    VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Space, false, game)
                    task.wait(0.05)
                    VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Space, false, game)
                end
            end)
        end
    end
end)

_G.AutofarmButton.MouseButton1Click:Connect(function()
    _G.AutofarmEnabled = not _G.AutofarmEnabled
    if _G.AutofarmEnabled then
        _G.AutofarmButton.Text = "АВТО ФАРМ: ВКЛ"
        _G.AutofarmButton.BackgroundColor3 = Color3.fromRGB(0, 180, 0)
        
        task.spawn(function()
            while _G.AutofarmEnabled do
                if not savedPickupCFrame or not savedDropoffCFrame then
                    local p = findPickup() local d = findDropoff()
                    if p then savedPickupCFrame = p.CFrame end
                    if d then savedDropoffCFrame = d.CFrame end
                end
                if not savedPickupCFrame or not savedDropoffCFrame then task.wait(0.3) continue end
                
                -- Жесткая проверка существования персонажа перед действием
                local char = localPlayer.Character
                if not char or not char:FindFirstChild("HumanoidRootPart") then 
                    task.wait(0.1) 
                    continue 
                end
                
                local humanoid = char:WaitForChild("Humanoid", 5)
                if not humanoid or humanoid.Health <= 0 then 
                    task.wait(0.1) 
                    continue 
                end
                
                instantTeleport(savedPickupCFrame)
                task.wait(0.2)
                
                forceRotateCamera180() 
                task.wait(0.05)
                
                pressEThreeTimes()
                task.wait(0.25)
                
                if not _G.AutofarmEnabled then break end
                task.wait(1.01 + (math.random(0, 2) / 100))
                if not _G.AutofarmEnabled then break end
                
                -- Повторная проверка перед вторым телепортом (защита от падения скрипта)
                if not localPlayer.Character or not localPlayer.Character:FindFirstChild("HumanoidRootPart") then continue end
                
                instantTeleport(savedDropoffCFrame)
                task.wait(0.35)
                
                pressEThreeTimes()
                task.wait(0.15)
                
                if not _G.AutofarmEnabled then break end
                
                -- Безопасный сброс персонажа с ожиданием полной очистки
                if humanoid and humanoid.Health > 0 then
                    camera.CameraType = Enum.CameraType.Custom
                    camera.CameraSubject = humanoid
                    task.wait(0.01)
                    humanoid.Health = 0
                end
                
                -- Улучшенное ожидание нового персонажа (фикс зависания через 30 минут)
                localPlayer.CharacterAdded:Wait()
                local newChar = localPlayer.Character or localPlayer.CharacterAdded:Wait()
                newChar:WaitForChild("HumanoidRootPart", 10)
                task.wait(0.1)
            end
        end)
    else
        _G.AutofarmEnabled = false
        _G.AutofarmButton.Text = "АВТО ФАРМ: ВЫКЛ"
        _G.AutofarmButton.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
    end
end)
