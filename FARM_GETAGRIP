-- Создание строк статистики
TotalEarnedLabel = createLabel("TotalEarned", "Заработано: $0", Color3.fromRGB(255, 255, 255), 4)
MaxEarnedLabel = createLabel("MaxEarned", "Макс. за заказ: $0", Color3.fromRGB(255, 200, 50), 5)
HourlyRateLabel = createLabel("HourlyRate", "В час: ~$0/h", Color3.fromRGB(50, 255, 100), 6)

-- Логика денег
local players = game:GetService("Players")
local localPlayer = players.LocalPlayer
local leaderstats = localPlayer:WaitForChild("leaderstats", 10)
-- Авто-поиск валюты (Money, Cash, Dollars и т.д.)
local moneyValue = leaderstats and (leaderstats:FindFirstChild("Money") or leaderstats:FindFirstChild("Cash") or leaderstats:FindFirstChild("Dollars") or leaderstats:FindFirstChildWhichIsA("ValueBase"))

local totalEarned = 0
local maxSingleEarned = 0
local startTime = os.time()
local lastMoney = moneyValue and moneyValue.Value or 0

if moneyValue then
    moneyValue.Changed:Connect(function(newVal)
        if newVal > lastMoney then
            local gained = newVal - lastMoney
            totalEarned = totalEarned + gained
            if gained > maxSingleEarned and gained <= 100 then -- ограничение, чтобы не считало донаты/коды
                maxSingleEarned = gained
            end
            TotalEarnedLabel.Text = "Заработано: $" .. totalEarned
            MaxEarnedLabel.Text = "Макс. за заказ: $" .. maxSingleEarned
        end
        lastMoney = newVal
    end)
end

-- Поток обновления дохода в час (раз в 3 секунды)
task.spawn(function()
    while true do
        task.wait(3)
        local elapsed = os.time() - startTime
        if elapsed > 5 and totalEarned > 0 then
            local rate = math.floor((totalEarned / elapsed) * 3600)
            HourlyRateLabel.Text = "В час: ~$" .. rate .. "/h"
        end
    end
end)

-- Переменные логики автофарма
_G.AutofarmEnabled = false
local VirtualInputManager = game:GetService("VirtualInputManager")
local camera = workspace.CurrentCamera
local savedPickupCFrame = nil
local savedDropoffCFrame = nil

-- АНТИ-AFK
if not _G.AntiAFKConnected then
    _G.AntiAFKConnected = true
    localPlayer.Idled:Connect(function()
        VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Space, false, game)
        task.wait(0.03)
        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Space, false, game)
    end)
end

local function forceRotateCamera180()
    camera.CameraType = Enum.CameraType.Scriptable
    task.wait(0.01)
    for i = 1, 3 do
        camera.CFrame = camera.CFrame * CFrame.Angles(0, math.rad(60), 0)
        task.wait(0.05)
    end
    camera.CameraType = Enum.CameraType.Custom
end

local function pressEThreeTimes()
    for i = 1, 3 do
        VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)
        task.wait(0.04)
        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
        task.wait(0.04)
    end
end

local function instantTeleport(targetCFrame)
    local character = localPlayer.Character or localPlayer.CharacterAdded:Wait()
    local rootPart = character:WaitForChild("HumanoidRootPart", 5)
    if rootPart then
        localPlayer:RequestStreamAroundAsync(targetCFrame.Position)
        rootPart.CFrame = targetCFrame + Vector3.new(0, 3, 0)
    end
end

local function findDropoff()
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj.Name == "DropoffPoints" then
            local part = obj:FindFirstChild("Part", true) or obj:FindFirstChildWhichIsA("BasePart", true)
            if part then return part end
        end
    end
    return nil
end

local function findPickup()
    local pickupFolder = workspace:FindFirstChild("Pickup")
    if pickupFolder then
        local part = pickupFolder:FindFirstChildWhichIsA("BasePart", true) or (pickupFolder:IsA("BasePart") and pickupFolder)
        if part then return part end
    end
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj.Name == "Pickup" then
            local part = obj:FindFirstChildWhichIsA("BasePart", true) or (obj:IsA("BasePart") and obj)
            if part then return part end
        end
    end
    return nil
end

DropoffButton.MouseButton1Click:Connect(function()
    local targetPart = findDropoff()
    if targetPart then savedDropoffCFrame = targetPart.CFrame; instantTeleport(savedDropoffCFrame)
    elseif savedDropoffCFrame then instantTeleport(savedDropoffCFrame) end
end)

PickupButton.MouseButton1Click:Connect(function()
    local targetPart = findPickup()
    if targetPart then savedPickupCFrame = targetPart.CFrame; instantTeleport(savedPickupCFrame)
    elseif savedPickupCFrame then instantTeleport(savedPickupCFrame) end
end)

-- ЦИКЛ ФАРМА
AutofarmButton.MouseButton1Click:Connect(function()
    _G.AutofarmEnabled = not _G.AutofarmEnabled
    
    if _G.AutofarmEnabled then
        AutofarmButton.Text = "АВТО ФАРМ: ВКЛ"
        AutofarmButton.BackgroundColor3 = Color3.fromRGB(0, 180, 0)
        
        task.spawn(function()
            while _G.AutofarmEnabled do
                if not savedPickupCFrame or not savedDropoffCFrame then
                    local pPart = findPickup()
                    local dPart = findDropoff()
                    if pPart then savedPickupCFrame = pPart.CFrame end
                    if dPart then savedDropoffCFrame = dPart.CFrame end
                end
                
                if not savedPickupCFrame or not savedDropoffCFrame then
                    AutofarmButton.Text = "Поиск точек..."
                    task.wait(0.5)
                    continue
                end
                
                local char = localPlayer.Character or localPlayer.CharacterAdded:Wait()
                local humanoid = char:WaitForChild("Humanoid", 5)
                char:WaitForChild("HumanoidRootPart", 5)
                
                instantTeleport(savedPickupCFrame)
                task.wait(0.2)
                
                forceRotateCamera180() 
                task.wait(0.05)
                
                pressEThreeTimes()
                task.wait(0.25)
                
                if not _G.AutofarmEnabled then break end
                
                instantTeleport(savedDropoffCFrame)
                task.wait(0.35)
                
                pressEThreeTimes()
                task.wait(0.15)
                
                if not _G.AutofarmEnabled then break end
                
                if humanoid then
                    humanoid.Health = 0
                end
                
                localPlayer.CharacterAdded:Wait()
            end
        end)
    else
        _G.AutofarmEnabled = false
        AutofarmButton.Text = "АВТО ФАРМ: ВЫКЛ"
        AutofarmButton.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
    end
end)
