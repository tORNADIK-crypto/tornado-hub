    lbl.Font = Enum.Font.SourceSans
    lbl.TextSize = 12
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Parent = frame
    
    local buy = Instance.new("TextButton")
    buy.Size = UDim2.new(0, 90, 1, -2)
    buy.Position = UDim2.new(0, 145, 0, 1)
    buy.Font = Enum.Font.SourceSansBold
    buy.TextSize = 11
    buy.TextColor3 = Color3.fromRGB(255, 255, 255)
    buy.Parent = frame
    
    if mode == "weld" then
        buy.BackgroundColor3 = Color3.fromRGB(210, 110, 0)
        buy.Text = "ОДЕТЬ (ФЕЙК)"
    else
        buy.BackgroundColor3 = Color3.fromRGB(0, 120, 200)
        buy.Text = "ТП К ШМОТКЕ"
    end
    
    buy.MouseButton1Click:Connect(function()
        local shopPurchases = workspace:FindFirstChild("ShopPurchases")
        local itemObj = shopPurchases and shopPurchases:FindFirstChild(searchName, true)
        
        if mode == "weld" and itemObj then
            weldVestToPlayer(itemObj)
        elseif mode == "tp" then
            if itemObj then
                local targetPart = itemObj:IsA("BasePart") and itemObj or itemObj:FindFirstChildWhichIsA("BasePart", true)
                if targetPart then shopTeleport(targetPart.Position + Vector3.new(0, 2, 2)) end
            else
                -- Если камера или спидометр лежат в корне папки ShopPurchases
                local directObj = shopPurchases and shopPurchases:FindFirstChild(searchName)
                if directObj and directObj:IsA("BasePart") then
                    shopTeleport(directObj.Position + Vector3.new(0, 2, 2))
                end
            end
        end
    end)
end

