-- Вспомогательные функции взаимодействия
local function triggerPrompt(parentPart)
    if parentPart then
        local prompt = parentPart:FindFirstChildOfClass("ProximityPrompt") or parentPart:FindFirstChildWhichIsA("ProximityPrompt", true)
        if prompt then
            if fireproximityprompt then fireproximityprompt(prompt, 1)
            else prompt:InputHoldBegin() task.wait(prompt.HoldDuration > 0 and prompt.HoldDuration or 1.0) prompt:InputHoldEnd() end
        end
    end
end

local function findDeepPart(parent)
    for _, child in ipairs(parent:GetChildren()) do
        if child:IsA("BasePart") and child.Name == "Part" then return child
        elseif child:IsA("Model") then local found = findDeepPart(child) if found then return found end end
    end
    return nil
end
