-- Переменные логики
_G.AutofarmEnabled = false
local VirtualInputManager = game:GetService("VirtualInputManager")
local camera = workspace.CurrentCamera
local players = game:GetService("Players")
local localPlayer = players.LocalPlayer

local savedPickupCFrame = nil
local savedDropoffCFrame = nil

-- ВСТРОЕННЫЙ АНТИ-AFK (Чтобы не кикало через 20 минут)
if not _G.AntiAFKConnected then
    _G.AntiAFKConnected = true
    localPlayer.Idled:Connect(function()
        VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Space, false, game)
        task.wait(0.05)
        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Space, false, game)
    end)
end

-- УСКОРЕННЫЙ РАЗВОРOT КАМЕРЫ (0.3 секунды вместо 1.0)
local function forceRotateCamera180()
    camera.CameraType = Enum.CameraType.Scriptable
    task.wait(0.01)
    
    -- 3 быстрых шага по 60 градусов
    for i = 1, 3 do
        camera.CFrame = camera.CFrame * CFrame.Angles(0, math.rad(60), 0)
        task.wait(0.1)
    end
    
    camera.CameraType = Enum.CameraType.Custom
end

-- Тройное прожатие E
local function pressEThreeTimes()
    for i = 1, 3 do
        VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)
        task.wait(0.05)
        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
        task.wait(0.05)
    end
end

-- Мгновенный телепорт
local function instantTeleport(targetCFrame)
    local character = localPlayer.Character or localPlayer.CharacterAdded:Wait()
    local rootPart = character:WaitForChild("HumanoidRootPart", 5)
    if rootPart then
        localPlayer:RequestStreamAroundAsync(targetCFrame.Position)
        rootPart.CFrame = targetCFrame + Vector3.new(0, 3, 0)
    end
end

-- Поиск объектов
local function findDropoff()
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj.Name == "DropoffPoints" then
            local part = obj:FindFirstChild("Part", true) or obj:FindFirstChildWhichIsA("BasePart", true)
            if part then return part end
        end
    end
    return nil
end

local function findPickup()
    local pickupFolder = workspace:FindFirstChild("Pickup")
    if pickupFolder then
        local part = pickupFolder:FindFirstChildWhichIsA("BasePart", true) or (pickupFolder:IsA("BasePart") and pickupFolder)
        if part then return part end
    end
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj.Name == "Pickup" then
            local part = obj:FindFirstChildWhichIsA("BasePart", true) or (obj:IsA("BasePart") and obj)
            if part then return part end
        end
    end
    return nil
end

-- Обычные кнопки
DropoffButton.MouseButton1Click:Connect(function()
    local targetPart = findDropoff()
    if targetPart then
        savedDropoffCFrame = targetPart.CFrame
        instantTeleport(savedDropoffCFrame)
    elseif savedDropoffCFrame then
        instantTeleport(savedDropoffCFrame)
    end
end)

PickupButton.MouseButton1Click:Connect(function()
    local targetPart = findPickup()
    if targetPart then
        savedPickupCFrame = targetPart.CFrame
        instantTeleport(savedPickupCFrame)
    elseif savedPickupCFrame then
        instantTeleport(savedPickupCFrame)
    end
end)

-- НАСТРОЕННЫЙ ЦИКЛ С ПРИНУДИТЕЛЬНЫМ ПОВОРОТОМ (ОПТИМИЗИРОВАННЫЙ)
AutofarmButton.MouseButton1Click:Connect(function()
    _G.AutofarmEnabled = not _G.AutofarmEnabled
    
    if _G.AutofarmEnabled then
        AutofarmButton.Text = "АВТО ФАРМ: ВКЛ"
        AutofarmButton.BackgroundColor3 = Color3.fromRGB(0, 180, 0)
        
        task.spawn(function()
            while _G.AutofarmEnabled do
                -- Динамический поиск позиций, если они потерялись из памяти
                if not savedPickupCFrame or not savedDropoffCFrame then
                    local pPart = findPickup()
                    local dPart = findDropoff()
                    if pPart then savedPickupCFrame = pPart.CFrame end
                    if dPart then savedDropoffCFrame = dPart.CFrame end
                end
                
                if not savedPickupCFrame or not savedDropoffCFrame then
                    AutofarmButton.Text = "Поиск точек..."
                    task.wait(1)
                    continue -- Вместо выключения пробуем найти точки на следующем круге
                end
                
                local char = localPlayer.Character or localPlayer.CharacterAdded:Wait()
                local humanoid = char:WaitForChild("Humanoid", 5)
                char:WaitForChild("HumanoidRootPart", 5)
                task.wait(0.1)
                
                -- ШАГ 1: ТП в PICKUP (Быстрее)
                instantTeleport(savedPickupCFrame)
                task.wait(0.4) -- Оптимальное время на прогрузку
                
                forceRotateCamera180() 
                task.wait(0.1)
                
                pressEThreeTimes()
                task.wait(0.4) -- Ждём коробку
                
                if not _G.AutofarmEnabled then break end
                
                -- ШАГ 2: ТП в DROPOFF (Быстрее)
                instantTeleport(savedDropoffCFrame)
                task.wait(0.6) -- Сокращено с 2.0 секунд до безопасного минимума
                
                pressEThreeTimes()
                task.wait(0.3) 
                
                if not _G.AutofarmEnabled then break end
                
                -- ШАГ 3: Мгновенный Ресет
                if humanoid then
                    humanoid.Health = 0
                end
                
                localPlayer.CharacterAdded:Wait()
                task.wait(0.1) -- Крошечная пауза перед новым кругом
            end
        end)
    else
        _G.AutofarmEnabled = false
        AutofarmButton.Text = "АВТО ФАРМ: ВЫКЛ"
        AutofarmButton.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
    end
end)
