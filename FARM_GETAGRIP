-- Плавный полет (Tween) к конфете
local function flyToCFrame(targetCFrame)
    local char = game.Players.LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end

    local distance = (hrp.Position - targetCFrame.Position).Magnitude
    local speed = 120 -- Скорость полета
    local duration = distance / speed

    local tweenInfo = TweenInfo.new(duration, Enum.EasingStyle.Linear)
    local tween = game:GetService("TweenService"):Create(hrp, tweenInfo, {CFrame = targetCFrame})
    
    tween:Play()
    tween.Completed:Wait()
    return true
end

-- Имитация движений вперед-назад на месте
local function jitterMovement()
    local char = game.Players.LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if hrp then
        hrp.CFrame = hrp.CFrame * CFrame.new(0, 0, 2)
        task.wait(0.15)
        hrp.CFrame = hrp.CFrame * CFrame.new(0, 0, -4)
        task.wait(0.15)
        hrp.CFrame = hrp.CFrame * CFrame.new(0, 0, 2)
    end
end

-- Обновление/создание ESP для Брукхейвена
local function updateESP()
    EspFolder:ClearAllChildren()
    if not espActive or not candyFolder then return end

    for _, candy in pairs(candyFolder:GetChildren()) do
        if (candy:IsA("BasePart") or candy:IsA("MeshPart")) and not visitedCandies[candy.Name] then
            local box = Instance.new("BoxHandleAdornment")
            box.Size = candy.Size + Vector3.new(0.5, 0.5, 0.5)
            box.AlwaysOnTop = true
            box.ZIndex = 5
            box.Color3 = Color3.fromRGB(255, 120, 0)
            box.Adornee = candy
            box.Transparency = 0.4
            box.Parent = EspFolder

            local billboard = Instance.new("BillboardGui")
            billboard.Size = UDim2.new(0, 100, 0, 30)
            billboard.AlwaysOnTop = true
            billboard.Adornee = candy
            billboard.StudsOffset = Vector3.new(0, 3, 0)
            billboard.Parent = EspFolder

            local label = Instance.new("TextLabel")
            label.Size = UDim2.new(1, 0, 1, 0)
            label.BackgroundTransparency = 1
            label.Text = candy.Name
            label.TextColor3 = Color3.fromRGB(255, 255, 255)
            label.TextStrokeTransparency = 0
            label.TextSize = 12
            label.Font = Enum.Font.SourceSansBold
            label.Parent = billboard
        end
    end
end

-- Поиск следующей конфеты
local function getNextCandy()
    if not candyFolder then return nil end
    for _, candy in pairs(candyFolder:GetChildren()) do
        if candy:IsA("BasePart") or candy:IsA("MeshPart") or candy:IsA("Model") then
            if not visitedCandies[candy.Name] then
                return candy
            end
        end
    end
    return nil
end

-- Умная функция сбора конфет
local function collectCandy(candy)
    local char = game.Players.LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    
    if hrp and candy and candy.Parent then
        local targetCFrame = candy:IsA("Model") and (candy:GetPrimaryPartCFrame() or candy:FindFirstChildWhichIsA("BasePart").CFrame) or candy.CFrame
        
        if targetCFrame then
            noclipOn = false
            flyToCFrame(targetCFrame + Vector3.new(0, 1.5, 0))
            task.wait(0.2)
            
            jitterMovement()
            
            local startTime = tick()
            local collected = false
            while tick() - startTime < 2 do
                if not candy or not candy.Parent then
                    collected = true
                    break
                end
                task.wait(0.1)
            end
            
            if not collected and candy and candy.Parent then
                noclipOn = true
                hrp.CFrame = targetCFrame
                jitterMovement()
                task.wait(0.5)
                noclipOn = false
            end
            
            visitedCandies[candy.Name] = true
            if espActive then updateESP() end
        end
    end
end

