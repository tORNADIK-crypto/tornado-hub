-- Логика плавного скрытия / открытия
local menuVisible = true
local function toggleMenu()
    menuVisible = not menuVisible
    if menuVisible then
        MainFrame.Visible = true
        animate(MainFrame, TweenInfo.new(0.3, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {Size = UDim2.new(0, 580, 0, 380), BackgroundTransparency = 0.25})
        ToggleCircle.Visible = false
    else
        animate(MainFrame, TweenInfo.new(0.2, Enum.EasingStyle.Quint, Enum.EasingDirection.In), {Size = UDim2.new(0, 580, 0, 0), BackgroundTransparency = 1})
        task.delay(0.2, function() 
            if not menuVisible then 
                MainFrame.Visible = false 
                ToggleCircle.Visible = true
            end 
        end)
    end
end

MinimizeButton.MouseButton1Click:Connect(toggleMenu)
ToggleCircle.MouseButton1Click:Connect(toggleMenu)

