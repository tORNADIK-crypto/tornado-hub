-- [БЕСКОНЕЧНЫЙ ЕСП]: Виден сквозь всю карту на любых расстояниях за счет AlwaysOnTop
local function updateItemESP()
for _, hl in pairs(itemHighlights) do if hl then hl:Destroy() end end
table.clear(itemHighlights)
if not _G.EspAI2 and not _G.EspGP5 then return end
local bombar = workspace:FindFirstChild("Bombar_Shelter")
local habar = bombar and bombar:FindFirstChild("Хабар")
if habar then
for _, obj in pairs(habar:GetChildren()) do
local isAI = string.match(obj.Name, "АИ%-2")
local isGP = string.match(obj.Name, "ГП%-5")
if (isAI and _G.EspAI2) or (isGP and _G.EspGP5) then
local hl = Instance.new("Highlight")
hl.FillTransparency = 0.4
hl.OutlineTransparency = 0
hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop -- Максимальная дистанция
hl.Adornee = obj
hl.Parent = obj
if isAI then
hl.FillColor = Color3.fromRGB(255, 110, 0) -- Красивый оранжевый
hl.OutlineColor = Color3.fromRGB(255, 220, 100)
else
hl.FillColor = Color3.fromRGB(0, 230, 100) -- Красивый зеленый
hl.OutlineColor = Color3.fromRGB(180, 255, 180)
end
table.insert(itemHighlights, hl)
end
end
end
end
