// === ГЛОБАЛЬНЫЕ ПЕРЕМЕННЫЕ ===
let currentSelectedTags = [], currentUser = JSON.parse(sessionStorage.getItem('shark_user')) || null;
let lastMessageTime = 0, keyVerificationTimer = null;
let isKeyActivated = localStorage.getItem('shark_key_active_date') === new Date().toDateString();

// ГЕНЕРАЦИЯ ЕЖЕДНЕВНОГО КЛЮЧА
function generateDailyKey() {
    const d = new Date();
    return "SHARK-" + (d.getFullYear() * d.getDate() + d.getMonth() + 148).toString(16).toUpperCase() + "-KEY";
}

// === НАВИГАЦИЯ ===
function switchTab(tabId) {
    document.querySelectorAll('.tab-content').forEach(t => t.classList.remove('active-tab'));
    document.querySelectorAll('.nav-links .nav-btn').forEach(b => b.classList.remove('active'));
    
    const target = document.getElementById(tabId);
    if (target) target.classList.add('active-tab');
    
    const btn = Array.from(document.querySelectorAll('.nav-links .nav-btn')).find(b => b.getAttribute('onclick').includes(tabId)) || document.getElementById('nav-upload');
    if (btn) btn.classList.add('active');
    
    if (tabId === 'request') renderChat();
    if (tabId === 'key-tab') updateKeyTabUI();
}

// === УПРАВЛЕНИЕ ОКНОМ ВХОДА ===
function openAuthModal() { document.getElementById('authModal').style.display = 'flex'; toggleAuthForms(true); }
function closeAuthModal() { document.getElementById('authModal').style.display = 'none'; }
function toggleAuthForms(showLogin) {
    document.getElementById('loginFormBlock').style.display = showLogin ? 'block' : 'none';
    document.getElementById('registerFormBlock').style.display = showLogin ? 'none' : 'block';
}
function handleAuth(type) {
    const userDb = JSON.parse(localStorage.getItem('shark_users')) || [];
    
    if (type === 'register') {
        const rUser = document.getElementById('regUser').value.trim();
        const rEmail = document.getElementById('regEmail').value.trim();
        const rPass = document.getElementById('regPass').value.trim();
        
        if (!rUser || !rEmail || !rPass) return showToast("Заполни все 3 поля!");
        if (userDb.some(u => u.user.toLowerCase() === rUser.toLowerCase())) return showToast("Логин занят!");
        if (rUser.toLowerCase() === "cho_nax4") return showToast("Этот ник зарезервирован!");

        userDb.push({ user: rUser, email: rEmail, pass: rPass, isAdmin: false });
        localStorage.setItem('shark_users', JSON.stringify(userDb));
        showToast("Успешная регистрация! Войдите.");
        
        document.getElementById('regUser').value = ""; document.getElementById('regEmail').value = ""; document.getElementById('regPass').value = "";
        toggleAuthForms(true); return;
    }
    
    if (type === 'login') {
        const lUser = document.getElementById('loginUser').value.trim();
        const lPass = document.getElementById('loginPass').value.trim();
        if (!lUser || !lPass) return showToast("Введите данные!");
        
        const foundUser = userDb.find(u => u.user.toLowerCase() === lUser.toLowerCase() && u.pass === lPass);
        if (!foundUser) return showToast("Неверный логин или пароль!");
        
        currentUser = { username: foundUser.user, isAdmin: foundUser.isAdmin };
        sessionStorage.setItem('shark_user', JSON.stringify(currentUser));
        
        updateAuthUI(); closeAuthModal();
        showToast(currentUser.isAdmin ? "Привет, Создатель! 👑" : `Вы вошли: ${currentUser.username}`);
        
        document.getElementById('loginUser').value = ""; document.getElementById('loginPass').value = "";
    }
}

function updateAuthUI() {
    const authBtn = document.getElementById('authBtn'), greeting = document.getElementById('userGreeting'), uploadNav = document.getElementById('nav-upload');
    if (currentUser) {
        greeting.innerText = currentUser.username; authBtn.innerText = "Выйти";
        authBtn.onclick = () => { currentUser = null; sessionStorage.removeItem('shark_user'); updateAuthUI(); switchTab('about'); };
        uploadNav.style.display = 'flex';
    } else {
        greeting.innerText = ""; authBtn.innerText = "Войти"; authBtn.onclick = openAuthModal; uploadNav.style.display = 'none';
    }
    if (currentUser && currentUser.isAdmin && currentUser.username === "Cho_nax4") {
        isKeyActivated = true;
    }
    updateKeyTabUI();
    renderScripts();
}

// === КЛЮЧ СИСТЕМА LINKVERTISE STYLE ===
function updateKeyTabUI() {
    const icon = document.getElementById('keyLockIcon'), text = document.getElementById('keyStatusText'), actionBlock = document.getElementById('keyActionBlock'), inputBlock = document.getElementById('keyInputBlock');
    const isOwnerAdmin = currentUser && currentUser.isAdmin && currentUser.username === "Cho_nax4";
    
    if (isKeyActivated || isOwnerAdmin) {
        icon.className = "fas fa-lock-open gold-text";
        text.innerHTML = "Доступ получен! Скрипты разблокированы до конца дня. <br><b style='color:#00ff66;'>Ключ Дня: " + generateDailyKey() + "</b>";
        actionBlock.style.display = "none"; inputBlock.style.display = "none";
    } else {
        icon.className = "fas fa-lock gold-text";
        text.innerText = "Скрипты заблокированы. Получите ежедневный ключ, подписавшись на создателя.";
        actionBlock.style.display = "block"; inputBlock.style.display = "none";
    }
}

function startKeyVerification() {
    window.open('https://tiktok.com', '_blank');
    const timerBlock = document.getElementById('timerBlock'), countdown = document.getElementById('countdownSeconds');
    document.querySelector('#keyActionBlock .btn-auth').style.display = "none";
    timerBlock.style.display = "block";
    
    let seconds = 10; countdown.innerText = seconds;
    clearInterval(keyVerificationTimer);
    keyVerificationTimer = setInterval(() => {
        seconds--; countdown.innerText = seconds;
        if (seconds <= 0) {
            clearInterval(keyVerificationTimer); timerBlock.style.display = "none";
            document.getElementById('keyInputBlock').style.display = "block";
            showToast("Переход проверен! Введите ключ.");
            alert("Ваш Ключ Дня: " + generateDailyKey());
        }
    }, 1000);
}

function verifyUserKey() {
    if (document.getElementById('userKeyField').value.trim() === generateDailyKey()) {
        isKeyActivated = true;
        localStorage.setItem('shark_key_active_date', new Date().toDateString());
        showToast("Доступ активирован! 👑"); updateKeyTabUI(); renderScripts();
    } else {
        showToast("Неверный ключ дня!");
    }
}

// === ЧАТ ПОДДЕРЖКИ С АНТИ-СПАМОЙ ===
function renderChat() {
    const chatDisplay = document.getElementById('chatBoxDisplay'); if (!chatDisplay) return;
    chatDisplay.innerHTML = (JSON.parse(localStorage.getItem('shark_chat')) || []).map(msg => {
        const isMyMsg = currentUser && currentUser.username === msg.user;
        let msgClass = "chat-msg" + (isMyMsg ? " my-message" : "") + (msg.isAdmin ? " admin-message" : "");
        return `<div class="${msgClass}"><div class="msg-header"><span>${msg.isAdmin ? '👑 ' : ''}${msg.user}</span><span>${msg.time}</span></div><div>${msg.text}</div></div>`;
    }).join('');
    chatDisplay.scrollTop = chatDisplay.scrollHeight;
}

function sendChatMessage() {
    if (!currentUser) return showToast("Войдите!");
    if (Date.now() - lastMessageTime < 5000) return showToast("Анти-спам: Подождите 5 секунд!");

    const input = document.getElementById('chatMessageInput'), text = input.value.trim(); if (!text) return;
    const messages = JSON.parse(localStorage.getItem('shark_chat')) || [], now = new Date();
    
    messages.push({ id: Date.now(), user: currentUser.username, text: text, time: now.getHours().toString().padStart(2, '0') + ":" + now.getMinutes().toString().padStart(2, '0'), isAdmin: currentUser.isAdmin });
    localStorage.setItem('shark_chat', JSON.stringify(messages));
    lastMessageTime = Date.now(); input.value = ""; renderChat();
}
// === РЕНДЕР КАРТОЧЕК С МОДЕРАЦИЕЙ И ПРОВЕРКОЙ ПРАВ ===
function renderScripts() {
    const container = document.getElementById('scriptsContainer'); if (!container) return;
    const scripts = JSON.parse(localStorage.getItem('shark_scripts')) || [];
    container.innerHTML = "";

    const isSuperAdmin = currentUser && currentUser.isAdmin && currentUser.username === "Cho_nax4";
    
    const visibleScripts = scripts.filter(item => {
        if (item.approved) return true;
        if (isSuperAdmin) return true;
        if (currentUser && currentUser.username === item.author) return true;
        return false;
    });

    if (visibleScripts.length === 0) {
        container.innerHTML = `<p style="grid-column:1/-1;text-align:center;color:var(--text-muted);">Каталог пуст или скрипты ждут проверки.</p>`;
        return;
    }

    visibleScripts.forEach(item => {
        let tagsHTML = (item.tags || []).map(t => `<span class="mini-tag" style="cursor:pointer;" onclick="document.getElementById('scriptSearch').value='${t}';document.getElementById('scriptSearch').dispatchEvent(new Event('input'))">${t}</span>`).join('');
        let adminHTML = "";
        
        const isOwner = currentUser && currentUser.username === item.author;

        if (isSuperAdmin) {
            let moderationButtons = "";
            if (!item.approved) {
                moderationButtons = `
                    <button class="btn-admin-tool edit-btn" style="background:#00ff66;" onclick="approveScript(${item.id})"><i class="fas fa-check"></i> Одобрить</button>
                    <button class="btn-admin-tool del-btn" onclick="rejectScript(${item.id})"><i class="fas fa-times"></i> Отклонить</button>
                `;
            } else {
                moderationButtons = `
                    <button class="btn-admin-tool pause-btn" onclick="togglePauseScript(${item.id})"><i class="fas fa-pause"></i> Пауза</button>
                    <button class="btn-admin-tool edit-btn" onclick="editScript(${item.id})"><i class="fas fa-edit"></i> Изменить</button>
                    <button class="btn-admin-tool del-btn" onclick="deleteScript(${item.id})"><i class="fas fa-trash"></i> Удалить</button>
                `;
            }
            adminHTML = `<div class="admin-actions">${moderationButtons}</div>`;
        } else if (isOwner) {
            adminHTML = `
                <div class="admin-actions">
                    <button class="btn-admin-tool edit-btn" onclick="editScript(${item.id})"><i class="fas fa-edit"></i> Изменить</button>
                    <button class="btn-admin-tool del-btn" onclick="deleteScript(${item.id})"><i class="fas fa-trash"></i> Удалить</button>
                </div>`;
        }

        let modBadge = !item.approved 
            ? `<span class="card-badge" style="border-color:var(--warning); color:var(--warning); background:rgba(255,159,28,0.1);">На модерации</span>`
            : `<span class="card-badge">${item.game}</span>`;

        const isCopyDisabled = !isKeyActivated && !isSuperAdmin;

        const card = document.createElement('div');
        card.className = `card3d ${item.paused ? 'paused' : ''}`;
        card.setAttribute('data-search-data', `${item.title} ${item.game} ${item.desc} ${(item.tags||[]).join(' ')}`.toLowerCase());
        card.innerHTML = `
            <div class="card3d-inner">
                <span class="paused-label">На Паузе / Patch</span>
                ${modBadge}
                <i class="fas fa-code card-icon"></i>
                <h3>${item.title}</h3>
                <p>${item.desc}</p>
                <div class="card-tags">${tagsHTML}</div>
                <div style="display:flex;justify-content:space-between;margin-bottom:15px;font-size:12px;color:var(--text-muted);transform:translateZ(30px);">
                    <div>
                        <span style="cursor:pointer;margin-right:10px;color:#00ff66;" onclick="modifyStat(${item.id},'likes')"><i class="fas fa-thumbs-up"></i> ${item.likes||0}</span>
                        <span style="cursor:pointer;color:#ff3333;" onclick="modifyStat(${item.id},'dislikes')"><i class="fas fa-thumbs-down"></i> ${item.dislikes||0}</span>
                    </div>
                    <div>
                        <span><i class="fas fa-copy"></i> ${item.views||0} раз</span>
                    </div>
                </div>
                <div class="card-actions">
                    <button class="btn-script gold" ${item.paused ? 'disabled' : ''} onclick="handleCopyClick(${item.id}, this)">
                        ${isCopyDisabled ? '<i class="fas fa-lock"></i> Нужен Ключ' : 'Копировать код'}
                    </button>
                </div>
                ${adminHTML}
            </div>
        `;
        container.appendChild(card);
    });
    
    init3DEffect();
}

function handleCopyClick(id, button) {
    const isSuperAdmin = currentUser && currentUser.isAdmin && currentUser.username === "Cho_nax4";
    if (!isKeyActivated && !isSuperAdmin) {
        showToast("Получите Ключ в панели Ключ Система!");
        switchTab('key-tab');
        return;
    }

    let s = JSON.parse(localStorage.getItem('shark_scripts')) || [];
    let target = s.find(x => x.id === id);
    if (target) {
        if (target.paused) return showToast("Скрипт на паузе!");
        navigator.clipboard.writeText(target.code);
        modifyStat(id, 'views');
        showToast('Скопировано! ✅');
    }
}

function modifyStat(id, field) {
    let s = JSON.parse(localStorage.getItem('shark_scripts'));
    let target = s.find(x => x.id === id); if (target) target[field] = (target[field] || 0) + 1;
    localStorage.setItem('shark_scripts', JSON.stringify(s)); renderScripts();
}

function init3DEffect() {
    document.querySelectorAll('.card3d').forEach(c => {
        const inner = c.querySelector('.card3d-inner');
        if (!inner) return;
        c.onmousemove = (e) => { if (!c.classList.contains('paused')) { const r = c.getBoundingClientRect(); inner.style.transform = `rotateX(${-(e.clientY - r.top - r.height/2) / r.height * 20}deg) rotateY(${(e.clientX - r.left - r.width/2) / r.width * 20}deg)`; } };
        c.onmouseleave = () => inner.style.transform = 'rotateX(0deg) rotateY(0deg)';
    });
}

// === ФУНКЦИИ МОДЕРАЦИИ ДЛЯ CHO_NAX4 ===
function approveScript(id) {
    let s = JSON.parse(localStorage.getItem('shark_scripts')) || [];
    s = s.map(x => { if (x.id === id) x.approved = true; return x; });
    localStorage.setItem('shark_scripts', JSON.stringify(s));
    showToast("Скрипт одобрен! ✅"); renderScripts();
}

function rejectScript(id) {
    let s = JSON.parse(localStorage.getItem('shark_scripts')) || [];
    s = s.filter(x => x.id !== id); localStorage.setItem('shark_scripts', JSON.stringify(s));
    showToast("Скрипт отклонён!"); renderScripts();
}

// === ИЗМЕНЕНИЕ И ПУБЛИКАЦИЯ ===
function editScript(id) {
    let s = JSON.parse(localStorage.getItem('shark_scripts')) || [];
    let item = s.find(x => x.id === id); if (!item) return;
    if (currentUser.username !== "Cho_nax4" && currentUser.username !== item.author) return showToast("Нет доступа!");

    document.getElementById('editScriptId').value = item.id;
    document.getElementById('sbTitle').value = item.title;
    document.getElementById('sbGame').value = item.game;
    document.getElementById('sbDesc').value = item.desc;
    document.getElementById('sbCode').value = item.code;
    switchTab('upload-tab');
}

function saveScriptAction() {
    if (!currentUser) return showToast("Войдите!");
    const idVal = document.getElementById('editScriptId').value, title = document.getElementById('sbTitle').value.trim(), game = document.getElementById('sbGame').value.trim(), code = document.getElementById('sbCode').value.trim(), desc = document.getElementById('sbDesc').value.trim() || "Нет описания.";
    if (!title || !game || !code) return showToast("Заполни поля!");

    let s = JSON.parse(localStorage.getItem('shark_scripts')) || [];
    const isSuperAdmin = currentUser.username === "Cho_nax4";

    if (idVal) {
        s = s.map(x => { if (x.id == idVal) { x.title = title; x.game = game; x.desc = desc; x.code = code; } return x; });
        showToast("Изменения сохранены!");
    } else {
        s.push({ id: Date.now(), author: currentUser.username, title, game, desc, tags: [], code, paused: false, likes: 0, dislikes: 0, views: 0, approved: isSuperAdmin });
        showToast(isSuperAdmin ? "Скрипт опубликован! 👑" : "Отправлено на модерацию!");
    }
    localStorage.setItem('shark_scripts', JSON.stringify(s)); resetUploadForm(); renderScripts(); switchTab('scripts');
}

function resetUploadForm() {
    document.getElementById('editScriptId').value = "";
    document.getElementById('sbTitle').value = ""; document.getElementById('sbGame').value = ""; document.getElementById('sbCode').value = ""; document.getElementById('sbDesc').value = "";
}

function togglePauseScript(id) {
    let s = JSON.parse(localStorage.getItem('shark_scripts'));
    let t = s.find(x => x.id === id); if (t) t.paused = !t.paused;
    localStorage.setItem('shark_scripts', JSON.stringify(s)); renderScripts();
}

function deleteScript(id) {
    if (!confirm("Удалить этот скрипт?")) return;
    let s = JSON.parse(localStorage.getItem('shark_scripts')).filter(x => x.id !== id);
    localStorage.setItem('shark_scripts', JSON.stringify(s)); renderScripts();
}

// === ПОИСК ===
if (document.getElementById('scriptSearch')) {
    document.getElementById('scriptSearch').oninput = function(e) {
        const q = e.target.value.toLowerCase().trim(); if (q.length > 0) switchTab('scripts');
        document.querySelectorAll('#scriptsContainer .card3d').forEach(c => c.style.display = c.getAttribute('data-search-data').includes(q) ? 'block' : 'none');
    };
}

function showToast(text) { const t = document.getElementById('toastNotification'); t.innerText = text; t.classList.add('show'); setTimeout(() => t.classList.remove('show'), 2000); }
function toggleTag(p) { p.classList.toggle('selected'); }
window.onload = function() { updateAuthUI(); };
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SHARK SCRIPTS</title>
    <link rel="stylesheet" href="https://cloudflare.com">
    <link rel="stylesheet" href="style.css">
</head>
<body>

    <div id="toastNotification" class="toast">Успешно!</div>

    <header class="navbar">
        <div class="logo">SHARK<span>SCRIPTS</span></div>
        <nav class="nav-links">
            <button class="nav-btn active" onclick="switchTab('about')"><i class="fas fa-crown"></i> Обо мне</button>
            <button class="nav-btn" onclick="switchTab('key-tab')"><i class="fas fa-key"></i> Ключ Система</button>
            <button class="nav-btn" onclick="switchTab('scripts')"><i class="fas fa-terminal"></i> Скрипты</button>
            <button class="nav-btn" onclick="switchTab('injectors')"><i class="fas fa-shield-alt"></i> Инжекторы</button>
            <button class="nav-btn" onclick="switchTab('request')"><i class="fas fa-comments"></i> Чат & Запросы</button>
            <button class="nav-btn" id="nav-upload" onclick="switchTab('upload-tab')" style="display: none;"><i class="fas fa-upload"></i> Выложить</button>
        </nav>
        <div class="auth-block">
            <span id="userGreeting" class="user-greet"></span>
            <button class="btn-auth" id="authBtn" onclick="openAuthModal()">Войти</button>
        </div>
    </header>

    <main class="container">
        
        <div class="search-box">
            <i class="fas fa-search"></i>
            <input type="text" id="scriptSearch" placeholder="Поиск скриптов...">
        </div>

        <!-- 1 Вкладка -->
        <section id="about" class="tab-content active-tab">
            <div class="hero-block">
                <h1>Создатель <span class="gold-text">SHARK SCRIPTS</span></h1>
                <p class="sub-text">Добро пожаловать в хаб.</p>
                <div class="profile-cards">
                    <div class="profile-card robl"><h3>Roblox</h3><p class="gold-text">Cho_nax4</p></div>
                    <div class="profile-card tt"><h3>TikTok</h3><p class="gold-text">6tornadiks7</p></div>
                </div>
            </div>
        </section>

        <!-- Ключ Система -->
        <section id="key-tab" class="tab-content">
            <h2 class="section-title">Активация <span class="gold-text">Доступа</span></h2>
            <div class="form-container" style="text-align: center;">
                <i class="fas fa-lock gold-text" id="keyLockIcon" style="font-size: 50px; margin-bottom: 20px;"></i>
                <p id="keyStatusText" style="margin-bottom: 25px;">Скрипты заблокированы. Подпишитесь, чтобы получить ключ дня.</p>
                <div id="keyActionBlock">
                    <button class="btn-auth" style="width: 100%;" onclick="startKeyVerification()">Подписаться на TikTok</button>
                    <div id="timerBlock" style="display: none; margin-top: 15px;">Проверка подписки... <span id="countdownSeconds">10</span> сек.</div>
                </div>
                <div class="form-group" id="keyInputBlock" style="display: none; margin-top: 15px;">
                    <input type="text" id="userKeyField" placeholder="Вставьте ключ..." class="premium-input">
                    <button class="btn-script gold" style="width: 100%; margin-top: 10px;" onclick="verifyUserKey()">Активировать</button>
                </div>
            </div>
        </section>

        <!-- 2 Вкладка -->
        <section id="scripts" class="tab-content">
            <h2 class="section-title">Каталог <span class="gold-text">Скриптов</span></h2>
            <div class="cards-grid" id="scriptsContainer"></div>
        </section>

        <!-- 3 Вкладка -->
        <section id="injectors" class="tab-content">
            <h2 class="section-title">Топовые <span class="gold-text">Инжекторы</span></h2>
            <div class="cards-grid">
                <div class="card3d">
                    <div class="card3d-inner">
                        <i class="fas fa-bolt card-icon"></i>
                        <h3>Wave Executor</h3>
                        <p>Исполнение 99% UNC скриптов.</p>
                        <button class="btn-script gold" onclick="window.open('https://getwave.gg', '_blank')">Скачать</button>
                    </div>
                </div>
            </div>
        </section>

        <!-- 4 Вкладка -->
        <section id="request" class="tab-content">
            <h2 class="section-title">Чат <span class="gold-text">Запросов</span></h2>
            <div class="chat-wrapper">
                <div class="chat-box-display" id="chatBoxDisplay"></div>
                <div class="chat-input-panel">
                    <input type="text" id="chatMessageInput" placeholder="Ваш запрос (Таймаут 5 сек)..." class="premium-input">
                    <button class="btn-auth" onclick="sendChatMessage()"><i class="fas fa-paper-plane"></i></button>
                </div>
            </div>
        </section>

        <!-- 5 Вкладка -->
        <section id="upload-tab" class="tab-content">
            <h2 class="section-title" id="uploadTabTitle">Выложить <span class="gold-text">Скрипт</span></h2>
            <div class="form-container">
                <input type="hidden" id="editScriptId" value="">
                <div class="form-group"><label>Название</label><input type="text" id="sbTitle" class="premium-input"></div>
                <div class="form-group"><label>Игра</label><input type="text" id="sbGame" class="premium-input"></div>
                <div class="form-group"><label>Описание</label><textarea id="sbDesc" rows="2" class="premium-input"></textarea></div>
                <div class="form-group"><label>Код скрипта</label><textarea id="sbCode" rows="4" class="premium-input script-code-area"></textarea></div>
                <button class="btn-auth" style="width:100%;" id="uploadSubmitBtn" onclick="saveScriptAction()">Опубликовать</button>
            </div>
        </section>

    </main>

    <!-- МОДАЛКА -->
    <div id="authModal" class="modal">
        <div class="modal-content">
            <span class="close-modal" onclick="closeAuthModal()">&times;</span>
            <div id="loginFormBlock">
                <h3>Вход</h3>
                <input type="text" id="loginUser" placeholder="Логин" class="premium-input" style="margin-bottom: 10px;">
                <input type="password" id="loginPass" placeholder="Пароль" class="premium-input" style="margin-bottom: 15px;">
                <div class="modal-buttons">
                    <button class="btn-script gold" onclick="handleAuth('login')">Войти</button>
                    <button class="btn-script" onclick="toggleAuthForms(false)">Регистрация</button>
                </div>
            </div>
            <div id="registerFormBlock" style="display: none;">
                <h3>Регистрация</h3>
                <input type="text" id="regUser" placeholder="Логин" class="premium-input" style="margin-bottom: 10px;">
                <input type="email" id="regEmail" placeholder="Почта" class="premium-input" style="margin-bottom: 10px;">
                <input type="password" id="regPass" placeholder="Пароль" class="premium-input" style="margin-bottom: 15px;">
                <div class="modal-buttons">
                    <button class="btn-script gold" onclick="handleAuth('register')">Создать</button>
                    <button class="btn-script" onclick="toggleAuthForms(true)">Назад</button>
                </div>
            </div>
        </div>
    </div>

    <script src="script.js"></script>
</body>
</html>
