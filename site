:root {
    --bg-main: #06020b;
    --bg-card: rgba(18, 7, 32, 0.75);
    --neon-purple: #9d4edd;
    --neon-glow: rgba(157, 78, 221, 0.4);
    --royal-gold: linear-gradient(135deg, #ffe259 0%, #ffa751 100%);
    --gold-solid: #ffbe0b;
    --text-main: #f3eaff;
    --text-muted: #a393bf;
    --danger: #ff3333;
    --warning: #ff9f1c;
}
* { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Inter', sans-serif; }
body { background: radial-gradient(circle at 50% 0%, #1c0a35 0%, var(--bg-main) 70%); color: var(--text-main); min-height: 100vh; overflow-x: hidden; }

.navbar { display: flex; justify-content: space-between; align-items: center; padding: 15px 50px; background: rgba(10, 4, 18, 0.9); border-bottom: 2px solid rgba(255, 190, 11, 0.3); backdrop-filter: blur(12px); position: sticky; top: 0; z-index: 1000; }
.logo { font-size: 26px; font-weight: 900; text-transform: uppercase; background: var(--royal-gold); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
.logo span { color: #fff; }
.nav-links { display: flex; gap: 5px; background: rgba(255, 255, 255, 0.03); padding: 5px; border-radius: 12px; }

.nav-btn { background: transparent; border: none; color: var(--text-muted); font-size: 12px; font-weight: 700; padding: 10px 14px; border-radius: 10px; cursor: pointer; display: flex; align-items: center; gap: 6px; text-transform: uppercase; }
.nav-btn:hover, .nav-btn.active { color: #fff; background: rgba(157, 78, 221, 0.3); box-shadow: 0 0 10px var(--neon-purple); }
.auth-block { display: flex; align-items: center; gap: 15px; }
.user-greet { font-weight: 700; color: var(--gold-solid); }

.btn-auth { background: var(--royal-gold); color: #000; border: none; padding: 10px 20px; font-weight: 800; border-radius: 10px; cursor: pointer; box-shadow: 0 0 15px rgba(255, 167, 81, 0.4); }
.container { max-width: 1200px; margin: 30px auto; padding: 0 20px; }
.hero-block { text-align: center; padding: 40px 20px; background: linear-gradient(180deg, rgba(157, 78, 221, 0.1) 0%, transparent 100%); border-radius: 20px; border: 1px solid rgba(157, 78, 221, 0.15); }
.sub-text { color: var(--text-muted); margin-bottom: 30px; }

.profile-cards { display: flex; justify-content: center; gap: 20px; flex-wrap: wrap; }
.profile-card { background: rgba(15, 8, 28, 0.8); border-radius: 15px; padding: 20px; width: 280px; text-align: center; box-shadow: 0 10px 25px rgba(0,0,0,0.5); }
.profile-card.robl { border: 2px solid #ff4545; }
.profile-card.tt { border: 2px solid #00f2fe; }

.search-box { position: relative; max-width: 500px; margin: 0 auto 40px auto; }
.search-box input { width: 100%; padding: 14px 20px 14px 45px; background: rgba(20, 10, 35, 0.8); border: 1px solid rgba(157, 78, 221, 0.3); border-radius: 12px; color: #fff; }
.search-box i { position: absolute; left: 18px; top: 50%; transform: translateY(-50%); color: var(--gold-solid); }

.section-title { font-size: 28px; text-align: center; margin-bottom: 30px; font-weight: 800; }
.cards-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 25px; }

.card3d { perspective: 1000px; }
.card3d-inner { background: var(--bg-card); border: 1px solid rgba(157, 78, 221, 0.2); border-radius: 16px; padding: 20px; position: relative; transform-style: preserve-3d; transition: all 0.3s; box-shadow: 0 10px 25px rgba(0,0,0,0.6); }
.card3d.paused .card3d-inner { opacity: 0.4; border-color: var(--warning) !important; }
.paused-label { position: absolute; top: 40%; left: 50%; transform: translate(-50%, -50%); background: var(--warning); color: #000; padding: 6px 12px; font-weight: 900; border-radius: 6px; display: none; }
.card3d.paused .paused-label { display: block; }
.card3d:hover .card3d-inner { border-color: var(--gold-solid); box-shadow: 0 15px 30px rgba(157, 78, 221, 0.3); }

.card-badge { position: absolute; top: 15px; right: 15px; border: 1px solid var(--gold-solid); color: var(--gold-solid); padding: 2px 8px; border-radius: 4px; font-size: 10px; font-weight: 800; }
.card-icon { font-size: 35px; color: var(--gold-solid); margin-bottom: 12px; }
.card3d-inner h3 { font-size: 20px; margin-bottom: 6px; }
.card3d-inner p { font-size: 13px; color: var(--text-muted); margin-bottom: 15px; min-height: 38px; }

.card-tags { display: flex; gap: 4px; flex-wrap: wrap; margin-bottom: 15px; }
.mini-tag { font-size: 9px; background: rgba(157, 78, 221, 0.2); border: 1px solid var(--neon-purple); padding: 2px 5px; border-radius: 4px; }
.card-actions { display: flex; gap: 5px; }
.btn-script { flex: 1; background: rgba(157, 78, 221, 0.15); border: 1px solid var(--neon-purple); color: #fff; padding: 10px; font-weight: 700; border-radius: 8px; cursor: pointer; font-size: 12px; }
.btn-script.gold { background: var(--royal-gold); color: #000; border: none; }

.admin-actions { display: flex; gap: 4px; margin-top: 10px; }
.btn-admin-tool { flex: 1; padding: 6px; font-size: 9px; font-weight: 700; border: none; border-radius: 4px; cursor: pointer; color: #fff; text-transform: uppercase; }
.btn-admin-tool.pause-btn { background: var(--warning); color: #000; }
.btn-admin-tool.edit-btn { background: #00f2fe; color: #000; }
.btn-admin-tool.del-btn { background: var(--danger); }

.chat-wrapper { background: var(--bg-card); border: 1px solid rgba(157, 78, 221, 0.2); border-radius: 16px; max-width: 700px; margin: 0 auto; padding: 20px; }
.chat-box-display { height: 300px; overflow-y: auto; display: flex; flex-direction: column; gap: 10px; }
.chat-msg { max-width: 80%; padding: 10px 14px; border-radius: 12px; font-size: 13px; background: rgba(255,255,255,0.04); }
.chat-msg.my-message { align-self: flex-end; background: rgba(157, 78, 221, 0.2); border: 1px solid var(--neon-purple); }
.chat-msg.admin-message { border: 1px solid var(--gold-solid); background: rgba(255, 190, 11, 0.05); }
.msg-header { display: flex; justify-content: space-between; font-size: 10px; font-weight: 800; margin-bottom: 4px; }
.chat-input-panel { display: flex; gap: 8px; margin-top: 15px; }

.form-container { background: var(--bg-card); border: 1px solid rgba(157, 78, 221, 0.2); padding: 30px; border-radius: 16px; max-width: 600px; margin: 0 auto; }
.form-group { display: flex; flex-direction: column; gap: 6px; margin-bottom: 15px; }
.form-group label { font-size: 12px; font-weight: 700; color: var(--text-muted); }
.premium-input { width: 100%; background: rgba(13, 6, 20, 0.9); border: 1px solid rgba(157,78,221,0.3); padding: 12px; border-radius: 6px; color: white; font-size: 14px; outline: none; }

.tab-content { display: none; }
.tab-content.active-tab { display: block !important; }

.modal { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(6, 2, 11, 0.85); backdrop-filter: blur(4px); z-index: 2000; justify-content: center; align-items: center; }
.modal-content { background: #120720; border: 2px solid var(--gold-solid); padding: 30px; border-radius: 16px; width: 100%; max-width: 360px; position: relative; text-align: center; }
.close-modal { position: absolute; top: 10px; right: 15px; font-size: 24px; color: var(--text-muted); cursor: pointer; }
.modal-buttons { display: flex; gap: 8px; margin-top: 12px; }

.toast { position: fixed; bottom: 20px; right: -300px; background: var(--royal-gold); color: #000; padding: 12px 24px; border-radius: 8px; font-weight: 800; z-index: 10000; transition: right 0.4s; }
.toast.show { right: 20px; }

