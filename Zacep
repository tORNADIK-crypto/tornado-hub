-- [[ 2. ЛОГИКА АГРЕССИВНОГО ЗАЦЕПА (БЕЗ ИЗМЕНЕНИЙ) ]]
bind(runService.Heartbeat, function()
local char = lplayer.Character
local hrp = char and char:FindFirstChild("HumanoidRootPart")
local hum = char and char:FindFirstChildOfClass("Humanoid")
if not hrp or not hum then return end
if state.magnActive then
hum:ChangeState(Enum.HumanoidStateType.Physics)
if not targetVehicle then
local closestPart = nil
local minDst = 12
local vehiclesFolder = workspace:FindFirstChild("Vehicles")
local searchIn = vehiclesFolder and vehiclesFolder:GetDescendants() or workspace:GetDescendants()
for _, obj in pairs(searchIn) do
if obj:IsA("BasePart") and (obj.Name == "Body" or obj.Parent:FindFirstChild("VehicleSeat")) then
local dst = (hrp.Position - obj.Position).Magnitude
if dst < minDst then
minDst = dst
closestPart = obj
end
end
end
if closestPart then
targetVehicle = closestPart
relativeCFrame = targetVehicle.CFrame:ToObjectSpace(hrp.CFrame)
end
else
hrp.CFrame = targetVehicle.CFrame:ToWorldSpace(relativeCFrame)
hrp.AssemblyLinearVelocity = Vector3.zero
hrp.AssemblyAngularVelocity = Vector3.zero
end
end
end)
