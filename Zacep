-- Обновление списка игроков
local function refreshPlayerList()
local oldTarget = selectedTarget
playerList = {}
for _, plr in ipairs(players:GetPlayers()) do
if plr ~= lplayer then
table.insert(playerList, plr)
end
end
if #playerList == 0 then
selectedIndex = 1
selectedTarget = nil
targetNameLbl.Text = "Нет других игроков"
return
end
local foundIdx = nil
if oldTarget then
for i, plr in ipairs(playerList) do
if plr == oldTarget then
foundIdx = i
break
end
end
end
selectedIndex = foundIdx or math.clamp(selectedIndex, 1, #playerList)
selectedTarget = playerList[selectedIndex]
targetNameLbl.Text = string.format("[%d/%d] %s (@%s)", selectedIndex, #playerList, selectedTarget.DisplayName, selectedTarget.Name)
end
