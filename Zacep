-- Получение и экипировка дивана
local function getAndEquipCouch()
local char = lplayer.Character
local hrp = char and char:FindFirstChild("HumanoidRootPart")
local hum = char and char:FindFirstChildOfClass("Humanoid")
local backpack = lplayer:FindFirstChild("Backpack")
if not hrp or not hum then return nil end
local function findCouchTool()
for _, item in ipairs(char:GetChildren()) do
if item:IsA("Tool") and (item.Name:lower():find("couch") or item.Name:lower():find("диван")) then
return item
end
end
if backpack then
for _, item in ipairs(backpack:GetChildren()) do
if item:IsA("Tool") and (item.Name:lower():find("couch") or item.Name:lower():find("диван")) then
return item
end
end
end
return nil
end
local couch = findCouchTool()
if not couch then
local wsCom = workspace:FindFirstChild("WorkspaceCom")
local giveToolModel = (wsCom and wsCom:FindFirstChild("003_CouchGiveTool")) or workspace:FindFirstChild("003_CouchGiveTool", true)
if not giveToolModel then
actionStatus.Text = "Ошибка: 003_CouchGiveTool не найден!"
return nil
end
local seat = giveToolModel:FindFirstChild("Seat1") or giveToolModel:FindFirstChild("Seat2") or giveToolModel:FindFirstChildWhichIsA("Seat", true)
if not seat then
actionStatus.Text = "Ошибка: Seat1/Seat2 не найдены!"
return nil
end
actionStatus.Text = "Беру диван в 003_CouchGiveTool..."
hrp.CFrame = seat.CFrame + Vector3.new(0, 1.5, 0)
task.wait(0.12)
pcall(function() seat:Sit(hum) end)
for _ = 1, 20 do
couch = findCouchTool()
if couch then break end
task.wait(0.05)
end
hum.Jump = true
hum:ChangeState(Enum.HumanoidStateType.Jumping)
task.wait(0.15)
end
if couch and couch.Parent ~= char then
hum:EquipTool(couch)
task.wait(0.1)
end
return findCouchTool()
end
-- Проверка, села ли цель на диван
local function isTargetSeatedOnCouch(targetChar, couchTool)
local targetHum = targetChar and targetChar:FindFirstChildOfClass("Humanoid")
if not targetHum then return false end
-- Проверяем сиденья внутри самого инструмента-дивана
if couchTool then
for _, desc in ipairs(couchTool:GetDescendants()) do
if (desc:IsA("Seat") or desc:IsA("VehicleSeat")) and desc.Occupant == targetHum then
return true
end
end
end
-- Дополнительная проверка: цель перешла в состояние Sit вплотную к нам
if targetHum.Sit and targetHum.SeatPart then
local seatParent = targetHum.SeatPart.Parent
if seatParent and (seatParent == couchTool or seatParent:IsDescendantOf(lplayer.Character)) then
return true
end
end
return false
end
