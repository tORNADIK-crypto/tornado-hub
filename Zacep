end
end)
-- [[ ЛОГИКА АНЛОКА СКОРОСТИ И ПЛАВНОГО РАЗГОНА ]]
runService.Heartbeat:Connect(function()
if not speedUnlockActive then return end
local char = lplayer.Character
local hum = char and char:FindFirstChildOfClass("Humanoid")
if hum and hum.SeatPart and hum.SeatPart:IsA("VehicleSeat") then
local carSeat = hum.SeatPart
local speedLimit = targetSpeed * 0.6
if uis:IsKeyDown(Enum.KeyCode.W) then
currentSpeed = math.clamp(currentSpeed + 0.8, 0, speedLimit)
local look = carSeat.CFrame.LookVector
local flatLook = Vector3.new(look.X, 0, look.Z).Unit
carSeat.AssemblyLinearVelocity = Vector3.new(
flatLook.X * currentSpeed,
carSeat.AssemblyLinearVelocity.Y,
flatLook.Z * currentSpeed
)
else
currentSpeed = math.clamp(currentSpeed - 1.5, 0, speedLimit)
if currentSpeed > 5 then
local look = carSeat.CFrame.LookVector
local flatLook = Vector3.new(look.X, 0, look.Z).Unit
carSeat.AssemblyLinearVelocity = Vector3.new(
flatLook.X * currentSpeed,
carSeat.AssemblyLinearVelocity.Y,
flatLook.Z * currentSpeed
)
end
end
else
currentSpeed = 0
end
end)
