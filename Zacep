-- [[ 4. АНЛОК СКОРОСТИ ДО 100 000 + ПОВОРАЧИВАЕМОСТЬ И ДРИФТ ]]
bind(runService.Heartbeat, function(dt)
if not state.speedUnlockActive then return end
local char = lplayer.Character
local hum = char and char:FindFirstChildOfClass("Humanoid")
if hum and hum.SeatPart and hum.SeatPart:IsA("VehicleSeat") then
local carSeat = hum.SeatPart
local speedLimit = targetSpeed * 0.6
local accelStep = math.max(1.2, speedLimit * 0.03)
if uis:IsKeyDown(Enum.KeyCode.W) then
currentSpeed = math.clamp(currentSpeed + accelStep, 0, speedLimit)
elseif uis:IsKeyDown(Enum.KeyCode.S) then
currentSpeed = math.clamp(currentSpeed - accelStep * 1.5, -speedLimit * 0.4, speedLimit)
else
currentSpeed = currentSpeed * 0.96
if math.abs(currentSpeed) < 1 then currentSpeed = 0 end
end
local steerInput = 0
if uis:IsKeyDown(Enum.KeyCode.A) then steerInput = 1 end
if uis:IsKeyDown(Enum.KeyCode.D) then steerInput = -1 end
if steerInput ~= 0 and math.abs(currentSpeed) > 2 then
local turnRate = 2.6 * (1.6 - (driftFactor * 0.45))
local dirSign = currentSpeed >= 0 and 1 or -1
carSeat.CFrame = carSeat.CFrame * CFrame.Angles(0, steerInput * dirSign * turnRate * dt, 0)
end
if math.abs(currentSpeed) > 0.5 then
local look = carSeat.CFrame.LookVector
local flatLook = Vector3.new(look.X, 0, look.Z)
if flatLook.Magnitude > 0.001 then
flatLook = flatLook.Unit
local currentVel = carSeat.AssemblyLinearVelocity
local desiredVel = Vector3.new(flatLook.X * currentSpeed, currentVel.Y, flatLook.Z * currentSpeed)
local grip = math.clamp(1.15 - (driftFactor * 0.65), 0.15, 0.98)
carSeat.AssemblyLinearVelocity = currentVel:Lerp(desiredVel, grip)
end
end
else
currentSpeed = 0
end
end)
