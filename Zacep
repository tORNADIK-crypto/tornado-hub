-- Режим "Станд": парим вокруг цели, смотрим на неё и спамим F до посадки
local grabbed = false
local timeout = 4.0
local startTime = os.clock()
local angle = 0
local lastKeySpam = 0
local standConn
standConn = runService.Heartbeat:Connect(function(dt)
if not targetHrp or not targetHrp.Parent or not hrp or not hrp.Parent then return end
-- Вращаемся по плотной орбите вокруг игрока (радиус 1.6 студа), как станд
angle += dt * 16
local offset = Vector3.new(math.cos(angle) * 1.6, 0.3, math.sin(angle) * 1.6)
local targetPos = targetHrp.Position
local standPos = targetPos + offset
hrp.CFrame = CFrame.lookAt(standPos, Vector3.new(targetPos.X, standPos.Y, targetPos.Z))
hrp.AssemblyLinearVelocity = Vector3.zero
hrp.AssemblyAngularVelocity = Vector3.zero
end)
while os.clock() - startTime < timeout do
if not targetChar or not targetChar.Parent or not targetHrp or not targetHrp.Parent then
break
end
-- Проверяем, сел ли игрок на диван
if isTargetSeatedOnCouch(targetChar, couch) then
grabbed = true
break
end
-- Держим диван в руках, если он вдруг убрался
if couch.Parent ~= char then
local hum = char:FindFirstChildOfClass("Humanoid")
if hum then hum:EquipTool(couch) end
end
