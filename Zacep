-- Генератор кнопок-переключателей
local function createToggle(text, tag, order, callback)
    local btn = Instance.new("TextButton", scroll)
    btn.Size = UDim2.new(0.97, 0, 0, 40)
    btn.BackgroundColor3 = Color3.fromRGB(17, 17, 23)
    btn.Text = ""
    btn.AutoButtonColor = false
    btn.LayoutOrder = order

    local corner = Instance.new("UICorner", btn)
    corner.CornerRadius = UDim.new(0, 9)

    local stroke = Instance.new("UIStroke", btn)
    stroke.Color = Color3.fromRGB(34, 34, 44)
    stroke.Thickness = 1.2

    local nameLbl = Instance.new("TextLabel", btn)
    nameLbl.Size = UDim2.new(0.7, 0, 1, 0)
    nameLbl.Position = UDim2.new(0, 12, 0, 0)
    nameLbl.BackgroundTransparency = 1
    nameLbl.Text = text
    nameLbl.TextColor3 = Color3.fromRGB(205, 205, 215)
    nameLbl.Font = Enum.Font.GothamBold
    nameLbl.TextSize = 11
    nameLbl.TextXAlignment = Enum.TextXAlignment.Left

    local badge = Instance.new("TextLabel", btn)
    badge.Size = UDim2.new(0, 54, 0, 22)
    badge.Position = UDim2.new(1, -64, 0.5, -11)
    badge.BackgroundColor3 = Color3.fromRGB(26, 26, 34)
    badge.Text = tag or "OFF"
    badge.TextColor3 = Color3.fromRGB(140, 140, 155)
    badge.Font = Enum.Font.GothamBlack
    badge.TextSize = 10
    Instance.new("UICorner", badge).CornerRadius = UDim.new(0, 6)

    local active = false
    btn.MouseButton1Click:Connect(function()
        active = not active
        tweenService:Create(btn, TweenInfo.new(0.18), {
            BackgroundColor3 = active and Color3.fromRGB(38, 15, 20) or Color3.fromRGB(17, 17, 23)
        }):Play()
        tweenService:Create(stroke, TweenInfo.new(0.18), {
            Color = active and Color3.fromRGB(235, 50, 60) or Color3.fromRGB(34, 34, 44)
        }):Play()
        tweenService:Create(badge, TweenInfo.new(0.18), {
            BackgroundColor3 = active and Color3.fromRGB(235, 50, 60) or Color3.fromRGB(26, 26, 34),
            TextColor3 = active and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(140, 140, 155)
        }):Play()
        badge.Text = active and "ACTIVE" or "OFF"
        nameLbl.TextColor3 = active and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(205, 205, 215)
        callback(active)
    end)

    return btn
end

-- Генератор продвинутого ползунка с ручным вводом чисел
local function createSlider(titleText, minVal, maxVal, defaultVal, decimals, order, onChange)
    local box = Instance.new("Frame", scroll)
    box.Size = UDim2.new(0.97, 0, 0, 62)
    box.BackgroundColor3 = Color3.fromRGB(15, 15, 20)
    box.LayoutOrder = order
    Instance.new("UICorner", box).CornerRadius = UDim.new(0, 9)

    local stroke = Instance.new("UIStroke", box)
    stroke.Color = Color3.fromRGB(34, 34, 44)
    stroke.Thickness = 1.2

    local lbl = Instance.new("TextLabel", box)
    lbl.Size = UDim2.new(0.62, 0, 0, 24)
    lbl.Position = UDim2.new(0, 12, 0, 6)
    lbl.BackgroundTransparency = 1
    lbl.Text = titleText
    lbl.TextColor3 = Color3.fromRGB(190, 190, 205)
    lbl.Font = Enum.Font.GothamBold
    lbl.TextSize = 11
    lbl.TextXAlignment = Enum.TextXAlignment.Left

    -- Поле точного ввода значения
    local inputBox = Instance.new("TextBox", box)
    inputBox.Size = UDim2.new(0, 82, 0, 22)
    inputBox.Position = UDim2.new(1, -92, 0, 7)
    inputBox.BackgroundColor3 = Color3.fromRGB(24, 24, 32)
    inputBox.Text = tostring(defaultVal)
    inputBox.TextColor3 = Color3.fromRGB(255, 85, 95)
    inputBox.Font = Enum.Font.GothamBlack
    inputBox.TextSize = 11
    inputBox.ClearTextOnFocus = false
    Instance.new("UICorner", inputBox).CornerRadius = UDim.new(0, 6)

    local track = Instance.new("Frame", box)
    track.Size = UDim2.new(1, -24, 0, 6)
    track.Position = UDim2.new(0, 12, 0, 42)
    track.BackgroundColor3 = Color3.fromRGB(28, 28, 36)
    track.BorderSizePixel = 0
    Instance.new("UICorner", track).CornerRadius = UDim.new(1, 0)

    local fill = Instance.new("Frame", track)
    fill.Size = UDim2.new((defaultVal - minVal) / (maxVal - minVal), 0, 1, 0)
    fill.BackgroundColor3 = Color3.fromRGB(235, 50, 60)
    fill.BorderSizePixel = 0
    Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)

    local knob = Instance.new("TextButton", track)
    knob.Size = UDim2.new(0, 14, 0, 14)
    knob.Position = UDim2.new((defaultVal - minVal) / (maxVal - minVal), -7, 0.5, -7)
    knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    knob.Text = ""
    knob.AutoButtonColor = false
    Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)

    local isDragging = false
    local function setValue(rawVal)
local clamped = math.clamp(rawVal, minVal, maxVal)
if decimals then
clamped = math.floor(clamped * 10 + 0.5) / 10
else
clamped = math.floor(clamped + 0.5)
end
local pct = (clamped - minVal) / (maxVal - minVal)
fill.Size = UDim2.new(pct, 0, 1, 0)
knob.Position = UDim2.new(pct, -7, 0.5, -7)
inputBox.Text = tostring(clamped)
onChange(clamped)
end
knob.InputBegan:Connect(function(inp)
if inp.UserInputType == Enum.UserInputType.MouseButton1 then isDragging = true end
end)
track.InputBegan:Connect(function(inp)
if inp.UserInputType == Enum.UserInputType.MouseButton1 then isDragging = true end
end)
bind(uis.InputEnded, function(inp)
if inp.UserInputType == Enum.UserInputType.MouseButton1 then isDragging = false end
end)
bind(runService.RenderStepped, function()
if isDragging then
local mX = uis:GetMouseLocation().X
local pct = math.clamp((mX - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
setValue(minVal + pct * (maxVal - minVal))
end
end)
inputBox.FocusLost:Connect(function()
local num = tonumber(inputBox.Text)
if num then
setValue(num)
else
inputBox.Text = tostring(defaultVal)
end
end)
return setValue
end
