-- [[ ЛОГИКА ДИНАМИЧЕСКИХ ПЛАТФОРМ ]]
runService.Heartbeat:Connect(function()
    if not platActive then return end
    local char = lplayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    
    if (hrp.Position - lastPlatformPos).Magnitude > 3 then
        local raycastParams = RaycastParams.new()
        raycastParams.FilterDescendantsInstances = {char}
        raycastParams.FilterType = Enum.RaycastFilterType.Exclude
        
        local hit = workspace:Raycast(hrp.Position, Vector3.new(0, -4, 0), raycastParams)
        if not hit or hit.Instance.Name ~= "ZacepPad" then
            local p = Instance.new("Part")
            p.Name = "ZacepPad"
            p.Size = Vector3.new(6, 0.5, 6)
            p.Position = hrp.Position - Vector3.new(0, 3.2, 0)
            p.Transparency = 0.4
            p.Color = Color3.fromRGB(235, 70, 70)
            p.Anchored = true
            p.Material = Enum.Material.Neon
            p.Parent = workspace
            
            lastPlatformPos = p.Position
            debris:AddItem(p, 2)
        end
    end
end)

-- [[ ЛОГИКА СИСТЕМЫ ЗАЦЕПА ]]
runService.Heartbeat:Connect(function()
    local char = lplayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return end
    
    if magnActive then
        hum:ChangeState(Enum.HumanoidStateType.Physics)
        if not targetVehicle then
            local closestPart = nil
            local minDst = 12
            
            local vehiclesFolder = workspace:FindFirstChild("Vehicles")
            local searchIn = vehiclesFolder and vehiclesFolder:GetDescendants() or workspace:GetDescendants()
            
            for _, obj in pairs(searchIn) do
                if obj:IsA("BasePart") and (obj.Name == "Body" or obj.Parent:FindFirstChild("VehicleSeat")) then
                    local dst = (hrp.Position - obj.Position).Magnitude
                    if dst < minDst then
                        minDst = dst
                        closestPart = obj
                    end
                end
            end
            
            if closestPart then
                targetVehicle = closestPart
                relativeCFrame = targetVehicle.CFrame:ToObjectSpace(hrp.CFrame)
            end
        else
            hrp.CFrame = targetVehicle.CFrame:ToWorldSpace(relativeCFrame)
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero
        end
    end
end)

-- [[ ДОПОЛНИТЕЛЬНАЯ ФУНКЦИЯ ESP ТРАНСПОРТА ]]
local function addCarEsp(vehicleModel)
if not vehicleModel:IsA("Model") then return end
if carHighlights[vehicleModel] then return end
local hl = Instance.new("Highlight")
hl.FillColor = Color3.fromRGB(0, 160, 255)
hl.FillTransparency = 0.5
hl.OutlineColor = Color3.fromRGB(255, 255, 255)
hl.OutlineTransparency = 0
hl.Adornee = vehicleModel
hl.Parent = coreGui
carHighlights[vehicleModel] = hl
end
