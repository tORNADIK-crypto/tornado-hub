-- Блок: Системная логика, анимации и ESP рендеринг
-- Управляет состояниями кнопок, перетаскиванием (Drag), хоткеем Insert и отрисовкой Highlight ESP.

local function updateButtonVisuals(btn, stroke, textLabel, enabled, activeText, disabledText)
    local targetBg = enabled and Color3.fromRGB(45, 12, 28) or Color3.fromRGB(28, 15, 22)
    local targetText = enabled and THEME.TextLight or THEME.TextMuted
    local targetStroke = enabled and THEME.AccentPink or Color3.fromRGB(60, 30, 45)
    
    TweenService:Create(btn, TweenInfo.new(0.3, Enum.EasingStyle.Quad), {BackgroundColor3 = targetBg}):Play()
    TweenService:Create(stroke, TweenInfo.new(0.3, Enum.EasingStyle.Quad), {Color = targetStroke}):Play()
    TweenService:Create(textLabel, TweenInfo.new(0.3, Enum.EasingStyle.Quad), {TextColor3 = targetText}):Play()
    textLabel.Text = enabled and activeText or disabledText
end

local function toggleMinimize()
    shared.IS_MINIMIZED = not shared.IS_MINIMIZED
    if shared.IS_MINIMIZED then
        MainFrame.ClipsDescendants = true
        local t = TweenService:Create(MainFrame, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.In), {Size = UDim2.new(0, 0, 0, 0)})
        t:Play()
        t.Completed:Connect(function()
            if shared.IS_MINIMIZED then
                MainFrame.Visible = false
                MiniCircle.Position = UDim2.new(0, MainFrame.AbsolutePosition.X + 90, 0, MainFrame.AbsolutePosition.Y + 26)
                MiniCircle.Visible = true
                MiniCircle.Size = UDim2.new(0, 0, 0, 0)
                TweenService:Create(MiniCircle, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Size = UDim2.new(0, 60, 0, 60)}):Play()
            end
        end)
    else
        local t = TweenService:Create(MiniCircle, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {Size = UDim2.new(0, 0, 0, 0)})
        t:Play()
        t.Completed:Connect(function()
            if not shared.IS_MINIMIZED then
                MiniCircle.Visible = false
                MainFrame.Visible = true
                TweenService:Create(MainFrame, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Size = UDim2.new(0, 240, 0, 112)}):Play()
                task.delay(0.4, function() MainFrame.ClipsDescendants = false end)
            end
        end)
    end
end

