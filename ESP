local HighlightStorage = {}

local function applyESP(player, character)
    if HighlightStorage[player] then HighlightStorage[player]:Destroy() end
    
    local hl = Instance.new("Highlight")
    hl.Name = "BarhatHl_" .. player.Name
    hl.FillColor = THEME.ESPFill
    hl.FillTransparency = 0.55
    hl.OutlineColor = THEME.BarhatSoft
    hl.OutlineTransparency = 0
    hl.Adornee = character
    hl.Enabled = shared.ESP_ENABLED
    hl.Parent = CoreGui
    
    HighlightStorage[player] = hl
end

local function createESP(player)
    if player == LocalPlayer then return end
    if player.Character then applyESP(player, player.Character) end
    player.CharacterAdded:Connect(function(char) applyESP(player, char) end)
end

for _, p in ipairs(Players:GetPlayers()) do createESP(p) end
Players.PlayerAdded:Connect(createESP)
Players.PlayerRemoving:Connect(function(p) 
    if HighlightStorage[p] then HighlightStorage[p]:Destroy(); HighlightStorage[p] = nil end 
end)

ESPButton.MouseButton1Click:Connect(function()
    shared.ESP_ENABLED = not shared.ESP_ENABLED
    updateButtonVisuals(ESPButton, BtnStroke, StatusText, shared.ESP_ENABLED, "TORNADO ESP // ACTIVE", "TORNADO ESP // DISABLED")
    for _, hl in pairs(HighlightStorage) do
        if hl and hl:IsA("Highlight") then hl.Enabled = shared.ESP_ENABLED end
    end
end)
