        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            Gate.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)

    local Title = Instance.new("TextLabel") Title.Size = UDim2.new(1, 0, 0, 50) Title.Text = "★ ANIMALS PREMIUM SECURITY ★" Title.TextColor3 = Color3.fromRGB(255, 215, 0) Title.Font = Enum.Font.RobotoMono Title.BackgroundTransparency = 1 Title.Parent = Gate
