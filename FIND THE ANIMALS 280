-- Функция наполнения вкладки Settings (Вызывается при сборке Premium)
function Core:PopulatePremiumSettings()
    local SettingsPage = Core.SettingsPageFrame
    if not SettingsPage then return end
    local T = _G.Translations[_G.Lang]

    -- 1. Тумблер активации Premium Fly
    Core:AddPremiumToggle(SettingsPage, "PremFly", "PremFlyDesc", function(state)
        if _G.PremiumFlyToggleFunc then _G.PremiumFlyToggleFunc(state) end
    end)

    -- КОНСТРУКТОР ПЛАВНЫХ ЗОЛОТЫХ СЛАЙДЕРОВ С ПОДДЕРЖКОЙ ТАЧ-ПАЛЬЦА ДЛЯ СМАРТФОНОВ
    local function createLuxurySlider(parent, titleText, min, max, default, callback)
        local Frame = Instance.new("Frame")
        Frame.Size = UDim2.new(1, -10, 0, 55)
        Frame.BackgroundColor3 = Color3.fromRGB(25, 20, 15)
        Frame.BackgroundTransparency = _G.CurrentMenuOpacity or 0.35
        Frame.BorderSizePixel = 0
        Frame.ZIndex = 3
        Frame.Parent = parent
        table.insert(Core.PremiumCardsTable, Frame) -- Для динамического изменения прозрачности
        
        local Stroke = Instance.new("UIStroke") Stroke.Color = Color3.fromRGB(255, 215, 0) Stroke.Parent = Frame
        local Title = Instance.new("TextLabel") Title.Text = titleText .. ": " .. tostring(default) Title.Size = UDim2.new(0.8, 0, 0, 25) Title.Position = UDim2.new(0, 12, 0, 3) Title.TextColor3 = Color3.fromRGB(255, 255, 255) Title.Font = Enum.Font.GothamBold Title.TextSize = 12 Title.BackgroundTransparency = 1 Title.ZIndex = 4 Title.Parent = Frame
        local SliderBar = Instance.new("TextButton") SliderBar.Size = UDim2.new(1, -30, 0, 6) SliderBar.Position = UDim2.new(0, 15, 0, 34) SliderBar.BackgroundColor3 = Color3.fromRGB(15, 10, 5) SliderBar.Text = "" SliderBar.ZIndex = 4 SliderBar.Parent = Frame
        local SliderFill = Instance.new("Frame") SliderFill.Size = UDim2.new((default - min)/(max - min), 0, 1, 0) SliderFill.BackgroundColor3 = Color3.fromRGB(255, 215, 0) SliderFill.BorderSizePixel = 0 SliderFill.ZIndex = 5 SliderFill.Parent = SliderBar
        
        local sliding = false
        local function update(input)
            local ratio = math.clamp((input.Position.X - SliderBar.AbsolutePosition.X) / SliderBar.AbsoluteSize.X, 0, 1)
            SliderFill.Size = UDim2.new(ratio, 0, 1, 0)
            local currentVal = math.floor(min + (max - min) * ratio)
            Title.Text = titleText .. ": " .. tostring(currentVal)
            callback(currentVal)
        end
        SliderBar.InputBegan:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then sliding = true update(input) end end)
        UserInputService.InputChanged:Connect(function(input) if sliding and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then update(input) end end)
        UserInputService.InputEnded:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then sliding = false end end)
    end

    -- Слайдер 1: Изменение скорости полета Premium Fly
    _G.PremiumFlySpeed = 50
    createLuxurySlider(SettingsPage, T.FlySlider, 20, 250, 60, function(val) _G.PremiumFlySpeed = val end)

    -- Слайдер 2: Изменение скорости бега WalkSpeed (Без ограничений для Premium!)
    createLuxurySlider(SettingsPage, T.RunSlider, 16, 250, 16, function(val)
        if LocalPlayer.Character and LocalPlayer.Character:FindFirstChildWhichIsA("Humanoid") then
            LocalPlayer.Character:FindFirstChildWhichIsA("Humanoid").WalkSpeed = val
        end
    end)

    -- Слайдер 3: РЕГУЛИРОВКА ПРОЗРАЧНОСТИ ДО 100% (OPACITY SLIDER)
    _G.CurrentMenuOpacity = 0.25
    createLuxurySlider(SettingsPage, T.OpacityTitle .. " %", 0, 100, 25, function(val)
        local opacityRatio = val / 100
        _G.CurrentMenuOpacity = opacityRatio
        
        -- Плавно выставляем прозрачность главному окну
        if Core.MainFrame then Core.MainFrame.BackgroundTransparency = opacityRatio end
        
        -- Меняем прозрачность всех внутренних Premium-карточек
        if Core.PremiumCardsTable then
            for _, card in pairs(Core.PremiumCardsTable) do card.BackgroundTransparency = opacityRatio end
        end
        -- Если выкручено на 100 (то есть 1.0 прозрачности), гасим линии UIStroke
        if Core.MainFrame and Core.MainFrame:FindFirstChildWhichIsA("UIStroke") then
            Core.MainFrame:FindFirstChildWhichIsA("UIStroke").Transparency = (val == 100) and 1 or 0
        end
    end)

    -- Тумблер активации Premium Noclip
    local noclipActive = false
    Core:AddPremiumToggle(SettingsPage, "NoclipTitle", "NoclipDesc", function(state) noclipActive = state end)
    RunService.Stepped:Connect(function()
        if noclipActive and LocalPlayer.Character and not _G.StopAllHubLoops then
            for _, part in pairs(LocalPlayer.Character:GetChildren()) do if part:IsA("BasePart") then part.CanCollide = false end end
        end
    end)
end
